    if [ -z "$LXD_POOL" ] || [ "$LXD_POOL" = "null" ]; then
        LXD_POOL="default"
    fi
fi

ACTIVE_POOL_DRIVER=$(lxc storage list --format json | jq -r ".[] | select(.name==\"$LXD_POOL\") | .driver")

# Create dedicated LXD Project
if ! lxc project list --format csv 2>/dev/null | cut -d',' -f1 | grep -qx "$LXD_PROJECT"; then
    echo ""
    echo -e "${BYELLOW}-> Creating Host LXD Project:${NC} $LXD_PROJECT"
    echo ""
    confirm_or_abort "Create custom LXD project '$LXD_PROJECT'?"
    
    if [ "$SHARED_IMAGES" = false ]; then
        lxc project create "$LXD_PROJECT" -c features.images=true -c features.profiles=true -c features.storage.volumes=true
    else
        lxc project create "$LXD_PROJECT" -c features.images=false -c features.profiles=true -c features.storage.volumes=true
    fi
    PROJECT_CREATED=true
    lxc project set "$LXD_PROJECT" --property description="${PRETTY_REPRO} Isolated Environment ($DEPLOY_ID)"
    
    if [ "$ACTIVE_POOL_DRIVER" = "dir" ]; then
        lxc profile device add default root disk path=/ pool="$LXD_POOL" io.cache=writeback --project "$LXD_PROJECT"
    else
        lxc profile device add default root disk path=/ pool="$LXD_POOL" --project "$LXD_PROJECT"
    fi
    
    if [ "$NESTED" = false ]; then
        lxc profile device add default eth0 nic network="$PRIMARY_BRIDGE" name=eth0 --project "$LXD_PROJECT"
    fi
else
    echo ""
    echo -e "${BYELLOW}-> LXD Project '${NC}${LXD_PROJECT}${BYELLOW}' already exists, skipping...${NC}"
fi

