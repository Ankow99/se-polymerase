# Non-nested static IP network configuration
if [ "$NESTED" = false ]; then
    
    # Generate and Trust Volatile LXD Certificate
    echo ""
    echo -e "${BYELLOW}-> Generating volatile LXD certificate:${NC} ${VOLATILE_CERT}"
    
    CERT_NAME="$(basename "$VOLATILE_CERT")"
    
    # Generate the cert pair silently
    openssl req -x509 -newkey rsa:2048 -keyout "${VOLATILE_CERT}.key" -out "${VOLATILE_CERT}.crt" -nodes -days 30 -subj "/CN=${CERT_NAME}" 2>/dev/null
    
    # Trust the cert in the Host's LXD daemon
    lxc config trust add "${VOLATILE_CERT}.crt" --name "${CERT_NAME}"
    
    # Read contents and base64 encode to safely inject via LXD config
    CRT_B64=$(base64 -w0 "${VOLATILE_CERT}.crt")
    KEY_B64=$(base64 -w0 "${VOLATILE_CERT}.key")
    
    LXC_OPTIONAL_ARGS+=("-c" "user.lxd_cert_b64=$CRT_B64")
    LXC_OPTIONAL_ARGS+=("-c" "user.lxd_key_b64=$KEY_B64")
    
    # Configure Static IP using the dynamically calculated PRIMARY gateway
    [[ -z "$TLD" ]] && TLD="maas"
    [[ -z "$MAAS_DNS" ]] && MAAS_DNS="8.8.8.8"
    
    # Set netplan config with static IP, non DHCP and MAAS DNS server
    read -r -d '' STATIC_NET <<EOF
network:
  version: 2
  ethernets:
    default_nic:
      match:
        name: e*
      transmit-checksum-offload: false
      dhcp4: false
      addresses: [${PRIMARY_STATIC_IP}/${PRIMARY_MASK}]
      routes:
        - to: default
          via: $PRIMARY_GW_IP
      nameservers:
        addresses: [${PRIMARY_STATIC_IP}, ${PRIMARY_GW_IP}, ${MAAS_DNS}]
        search: [${TLD}, maas, lxd]
EOF
    
    # Inject static net config
    LXC_OPTIONAL_ARGS+=("-c" "cloud-init.network-config=$STATIC_NET")
    
    # Force LXD dnsmasq to resolve the orchestrator's static IP for the rest of the cluster safely
    TARGET_RECORD="host-record=${VM_NAME}.lxd,${PRIMARY_STATIC_IP}"
    CURRENT_DNSMASQ=$(lxc network get "$PRIMARY_BRIDGE" raw.dnsmasq 2>/dev/null || true)
    
    if [ -z "$CURRENT_DNSMASQ" ]; then
        lxc network set "$PRIMARY_BRIDGE" raw.dnsmasq="$TARGET_RECORD"
    elif ! echo "$CURRENT_DNSMASQ" | grep -qF "$TARGET_RECORD"; then
        # Append the new record on a new line to preserve existing configurations
        lxc network set "$PRIMARY_BRIDGE" raw.dnsmasq="${CURRENT_DNSMASQ}"$'\n'"${TARGET_RECORD}"
    fi
fi

# Attach to primary bridge
LXC_OPTIONAL_ARGS+=("-n" "$PRIMARY_BRIDGE")

