        echo ""
        echo "${UI_TOKEN}"
    else
        echo "  LXD UI Trust already configured! ($UI_IDENTITY)"
        echo "  If your browser was authenticated in a previous run, you can just log in."
        echo "  (To reset trust, run: lxc auth identity delete $UI_IDENTITY)"
    fi
