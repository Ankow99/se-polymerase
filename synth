echo ""
echo -e "${BYELLOW}-> 2. Lab registered as ID ${NC}#${SYNTH_ID}${BYELLOW} (${NC}${LXD_PROJECT}${BYELLOW})${NC}"

# ==========================================
# BACKGROUND HANDOVER
# ==========================================

# Parent Trap: If the user presses Ctrl+C or connection breaks, detach the worker and exit cleanly.
trap '
    [ -n "$TAIL_PID" ] && kill -9 "$TAIL_PID" 2>/dev/null
    stop_poller_and_clean
    exec 1>&3 2>&4 # Restore terminal output
    echo -ne "\033[?25h" # Force cursor to reappear
    echo ""
    echo -e "${BYELLOW}-> Detaching... Deployment will continue in background...${NC}"
    echo ""
    echo -e "To monitor progress: ${BYELLOW}${CMD_NAME} monitor ${SYNTH_ID}${NC}"
    echo -e "To abort & destroy:  ${BYELLOW}${CMD_NAME} destroy ${SYNTH_ID}${NC}"
    echo -e "To list labs:        ${BYELLOW}${CMD_NAME} list${NC}"
    echo ""
    exit 0
' INT TERM HUP

# Capture terminal height before forking so the headless worker knows how to size the UI
USER_TERM_HEIGHT=$(tput lines 2>/dev/null || echo 40)
echo "$USER_TERM_HEIGHT" > "$TERM_SIZE_FILE"

# Spawn a lightweight poller before closing FDs so it can track live window resizes
(
    trap 'if [ -n "$SLEEP_PID" ]; then kill "$SLEEP_PID" 2>/dev/null || true; fi; rm -f "$TERM_SIZE_FILE" 2>/dev/null || true' EXIT
    trap 'exit 0' INT TERM HUP
    
    while kill -0 $$ 2>/dev/null; do
        NEW_HEIGHT=$(stty size <&3 2>/dev/null | awk '{print $1}')
        if [ -n "$NEW_HEIGHT" ] && kill -0 $$ 2>/dev/null; then
            echo "$NEW_HEIGHT" > "$TERM_SIZE_FILE"
        fi
        sleep 2 &
        SLEEP_PID=$!
        wait $SLEEP_PID 2>/dev/null || true
    done
) &
POLLER_PID=$!
disown $POLLER_PID 2>/dev/null

# Fork remaining logic into a subshell so it can safely run headless
(
    # Close inherited terminal file descriptors to guarantee true detachment
    exec 3>&- 4>&-
    
    # Worker Trap: Enter auto-accept mode to breeze past remaining prompts silently if terminal detaches
    trap 'ACCEPT_DEFAULTS=true' INT HUP
    # Guarantee removal when the worker exits (even if parent detached earlier)
    trap 'rm -f "$TERM_SIZE_FILE" 2>/dev/null || true' EXIT
    trap 'exit 143' TERM
    
    DEPLOY_FAILED=false
    
    # ==========================================
    # OBTAIN LXD PRIMARY IP ADDRESS
    # ==========================================
    
    echo ""
    echo -e "${BYELLOW}-> 3. Obtaining IP Address...${NC}"
    echo ""
    
    IP=""
    TIMEOUT=0
    
    while [ -z "$IP" ]; do
        if [ "$TIMEOUT" -ge "$MAX_WAIT" ]; then
            echo -e "${BRED}Error: Timed out waiting for VM to get an IP address.${NC}"
            echo "Run '$CMD_NAME destroy ${SYNTH_ID}' to clean up the environment."
            lxc project set "$LXD_PROJECT" user.synth.status="failed" 2>/dev/null || true
            exit 1
        fi
        
        IP=$(get_vm_ipv4 "$LXD_PROJECT" "$VM_NAME")
        
        if [ -z "$IP" ]; then
            sleep 2
            TIMEOUT=$((TIMEOUT + 2))
        fi
    done
    
    echo "Target IP: $IP"
    echo ""
    
    lxc list --project "$LXD_PROJECT"
    
    # ==========================================
    # MAAS DASHBOARD ACCESS
    # ==========================================
    
    if grep -q "custom_maas_" "$CLOUD_INIT"; then
        echo ""
        echo -e "${BYELLOW}-> 4. Opening MAAS Dashboard...${NC}"
        echo ""
        
        MAAS_UI_URL="http://$IP:5240/MAAS/"
        
        echo "[ MAAS Dashboard ]" >> "$ACCESS_FILE"
        
        if [ -n "$SSH_CLIENT" ] || [ -n "$SSH_TTY" ] || [ -n "$SSH_CONNECTION" ]; then
            REMOTE_USER=$(whoami)
            SERVER_IP_GUESS=$(echo "${SSH_CONNECTION:-}" | awk '{print $3}')
            SERVER_IP_STR=${SERVER_IP_GUESS:-<SERVER_IP>}
            
            echo -e "${BYELLOW}  Remote SSH Session Detected!${NC}"
            echo "  To access the MAAS dashboard (once ready) locally, open a new terminal tab on your host and run:"
            echo ""
            echo -e "${BYELLOW}  Run:${NC} ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -N -L ${MAAS_LOCAL_PORT}:${IP}:5240 ${REMOTE_USER}@${SERVER_IP_STR}"
            echo -e "${BYELLOW}  URL:${NC} http://localhost:${MAAS_LOCAL_PORT}/MAAS/"
            echo ""
            
            # Append to access file
            {
                echo "  Tunnel:   ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -N -L ${MAAS_LOCAL_PORT}:${IP}:5240 ${REMOTE_USER}@${SERVER_IP_STR}"
                echo "  URL:      http://localhost:${MAAS_LOCAL_PORT}/MAAS/"
                echo ""
            } >> "$ACCESS_FILE"
            
            pause_to_continue "Press Enter to continue with live cloud-init log tailing..."
        else
            echo -e "${BYELLOW}  MAAS Dashboard:${NC} $MAAS_UI_URL"
            echo ""
            
            # Append to access file
            {
                echo "  URL:      http://$IP:5240/MAAS/"
                echo ""
            } >> "$ACCESS_FILE"
            
            echo -e "${BYELLOW}  Local session detected. Opening MAAS Dashboard...${NC}"
            if command -v xdg-open &> /dev/null; then
                xdg-open "$MAAS_UI_URL" > /dev/null 2>&1 &
            fi
        fi
    else
        echo ""
        echo -e "${BYELLOW}-> 4. Skipping MAAS Dashboard... (no MAAS detected)${NC}"
    fi
    
    # Write the Primary VM info to the access file
    print_cluster_inventory "primary" "quiet"
    
    # ==========================================
    # LOG TAILING + JUJU STATUS
    # ==========================================
    
    echo ""
    echo -e "${BYELLOW}-> 5. Connecting to live cloud-init logs... (will switch to Juju status)${NC}"
    echo ""
    
    PHASE="LOG_TAIL"
    CLUSTER_TRIGGER_FIRED=false
    CURSOR_TOP='\033[H'
    CLEAR_REST='\033[J'
    CLR_EOL=$'\033[K'
    LXD_API_FAILS=0
    
    while [ "$PHASE" != "DONE" ]; do
        
        # Prevent infinite loops if VM or Project is destroyed externally, allowing for transient API timeouts
        if ! lxc info "$VM_NAME" --project "$LXD_PROJECT" >/dev/null 2>&1; then
            LXD_API_FAILS=$((LXD_API_FAILS + 1))
            if [ "$LXD_API_FAILS" -ge 5 ]; then
                echo ""
                echo -e "${BRED}Fatal: VM '$VM_NAME' or Project '$LXD_PROJECT' no longer exists. Aborting watch loop.${NC}${CLR_EOL}"
                lxc project set "$LXD_PROJECT" user.synth.status="failed" 2>/dev/null || true
                exit 1
            fi
        else
            LXD_API_FAILS=0
        fi
        
        # PHASE A: LOG TAILING
        if [ "$PHASE" == "LOG_TAIL" ]; then
            
            # Stream the logs natively through bash so it can parse multiple triggers simultaneously line-by-line
            while IFS= read -r line; do
                echo "$line"
                
                # Check for the cluster inventory trigger
                if [ "$CLUSTER_TRIGGER_FIRED" != "true" ] && [ -n "$CLUSTER_TRIGGER_MSG" ] && [[ "$line" == *"$CLUSTER_TRIGGER_MSG"* ]]; then
                    print_cluster_inventory "nodes" "quiet"
                    CLUSTER_TRIGGER_FIRED="true"
                fi
                
                # Check for the Juju trigger or cloud-init finish
                if [ -n "$JUJU_TRIGGER_MSG" ] && [[ "$line" == *"$JUJU_TRIGGER_MSG"* ]]; then
                    PHASE="JUJU_WATCH"
                    lxc exec "$VM_NAME" --project "$LXD_PROJECT" -- pkill -f "tail.*cloud-init" 2>/dev/null || true
                    break
                elif [[ "$line" == *"finished at"* ]]; then
                    PHASE="DONE"
                    lxc exec "$VM_NAME" --project "$LXD_PROJECT" -- pkill -f "tail.*cloud-init" 2>/dev/null || true
                    break
                fi
            done < <(lxc exec "$VM_NAME" --project "$LXD_PROJECT" -- tail -n +1 -f /var/log/cloud-init-output.log 2>/dev/null)
            
            if [ "$PHASE" == "DONE" ] || [ "$PHASE" == "JUJU_WATCH" ]; then
                # Success! The 'sed' command found the Juju model deploy start and quit cleanly.
                sleep 2
                STATUS_CHECK=$(lxc exec "$VM_NAME" --project "$LXD_PROJECT" -- cloud-init status 2>/dev/null)
                
                if [[ "$STATUS_CHECK" == *"status: error"* ]]; then
                    echo ""
                    echo -e "${BRED}Error: cloud-init crashed during deployment! Check the logs above.${NC}${CLR_EOL}"
                    echo ""
                    echo -e "${BRED}----------------- Last 50 lines of cloud-init-output.log -----------------${NC}"
                    echo ""
                    lxc exec "$VM_NAME" --project "$LXD_PROJECT" -- bash -c "cat \$(ls -rt /var/log/cloud-init-output.log* 2>/dev/null) 2>/dev/null | tail -n 50 | sed 's/\r\$//; s/.*\r//; s/\x1b\[[0-9;?]*[A-Za-ln-z]//g'"
                    echo -ne "${NC}"
                    echo ""
                    echo -e "${BRED}--------------------------------------------------------------------------${NC}"
                    echo ""
                    echo "Connect using '${CMD_NAME} shell ${SYNTH_ID}' to debug what happened, or run '${CMD_NAME} destroy ${SYNTH_ID}' to clean up."
                    DEPLOY_FAILED=true
                    lxc project set "$LXD_PROJECT" user.synth.status="failed" 2>/dev/null || true
                    PHASE="DONE"
                elif [ "$PHASE" == "DONE" ]; then
                    echo ""
                    echo -e "${BYELLOW}cloud-init finished successfully! ${NC}${CLR_EOL}"
                elif [ "$PHASE" == "JUJU_WATCH" ]; then
                    echo ""
                    echo -e "${BYELLOW}Juju Deployment Trigger Detected. Switching to Watch Mode...${NC}${CLR_EOL}"
                fi
            else
                # If PHASE didn't change, the tail command died naturally (connection dropped or file not created yet)
                TEST_CONN=$(lxc exec "$VM_NAME" --project "$LXD_PROJECT" -- echo "ok" 2>/dev/null)
                if [ "$TEST_CONN" != "ok" ]; then
                    # SSH died (Connection Refused / Network Down / Rebooting)
                    echo -ne "${BYELLOW}Connection lost (Rebooting?) retrying...${NC}${CLR_EOL}\r"
                    sleep 3
                else
                    # Other errors (file not found yet, etc)
                    echo -ne "${BYELLOW}Waiting for log file creation...${NC}${CLR_EOL}\r"
                    sleep 2
                fi
            fi
        fi
        
        # PHASE B: JUJU WATCH
        if [ "$PHASE" == "JUJU_WATCH" ]; then
            
            # Catch the cluster inventory trigger if it fires during the Juju watch phase
            if [ "$CLUSTER_TRIGGER_FIRED" != "true" ] && [ -n "$CLUSTER_TRIGGER_MSG" ]; then
                if lxc exec "$VM_NAME" --project "$LXD_PROJECT" -- grep -Fq -- "$CLUSTER_TRIGGER_MSG" /var/log/cloud-init-output.log* 2>/dev/null; then
                    print_cluster_inventory "nodes" "quiet"
                    CLUSTER_TRIGGER_FIRED="true"
                fi
            fi
            
            # shellcheck disable=SC2016
            RAW_DATA=$(lxc exec "$VM_NAME" --project "$LXD_PROJECT" \
                --env SYS_USER="$SYS_USER" \
                --env JUJU_MODELS="$JUJU_MODELS" \
                --env LOG_LINES="$CLOUD_INIT_LOG_LINES" \
                -- bash -c '
                
                CI_STATUS=$(cloud-init status 2>/dev/null)
                
                echo "---STEP_START---"
                cat $(ls -rt /var/log/cloud-init-output.log* 2>/dev/null) 2>/dev/null | sed "s/\r$//; s/\x1b\[[0-9;?]*[A-Za-ln-z]//g" | grep -E -- "-------- .* --------" | tail -n 1
                echo "---STEP_END---"
                
                echo "---LOG_START---"
                cat $(ls -rt /var/log/cloud-init-output.log* 2>/dev/null) 2>/dev/null | tail -n "$LOG_LINES" | sed "s/\r$//; s/.*\r//; s/\x1b\[[0-9;?]*[A-Za-ln-z]//g"
                echo ""
                echo "---LOG_END---"
                
                echo "---JUJU_START---"
                if command -v juju >/dev/null; then
                    JUJU_EXEC="sudo -H -u $SYS_USER"
                    
                    EXISTING_MODELS=$($JUJU_EXEC juju models --format=json 2>/dev/null | jq -r ".models[].name" 2>/dev/null | sed "s#.*/##")
                    TARGET_MODEL="controller"
                    for m in $JUJU_MODELS; do
                        if echo "$EXISTING_MODELS" | grep -qx "$m"; then
                            TARGET_MODEL="$m"
                            break
                        fi
                    done
                    $JUJU_EXEC juju status -m $TARGET_MODEL --color 2>/dev/null || echo "Waiting for Juju models to initialize..."
                else
                    echo "Waiting for Juju to be installed..."
                fi
                echo "---JUJU_END---"
                
                echo "---CI_START---"
                echo "$CI_STATUS"
                echo "---CI_END---"
            ' 2>/dev/null)
            
            LXC_EXIT=$?
            
            if [ $LXC_EXIT -eq 0 ]; then
                STEP_OUTPUT=$(echo "$RAW_DATA" | sed -n '/^---STEP_START---/,/^---STEP_END---/{/^---STEP_START---/d;/^---STEP_END---/d;p}')
                LOG_OUTPUT=$(echo "$RAW_DATA" | sed -n '/^---LOG_START---/,/^---LOG_END---/{/^---LOG_START---/d;/^---LOG_END---/d;p}')
                JUJU_OUTPUT=$(echo "$RAW_DATA" | sed -n '/^---JUJU_START---/,/^---JUJU_END---/{/^---JUJU_START---/d;/^---JUJU_END---/d;p}')
                CI_STATUS=$(echo "$RAW_DATA" | sed -n '/^---CI_START---/,/^---CI_END---/{/^---CI_START---/d;/^---CI_END---/d;p}')
                
                # Check if it should stop (is cloud-init done?)
                if [[ "$CI_STATUS" == *"status: error"* ]]; then
                    echo ""
                    echo -e "${BRED}Error: cloud-init crashed during deployment! Check the logs above.${NC}${CLR_EOL}"
                    echo ""
                    echo -e "${BRED}----------------- Last 50 lines of cloud-init-output.log -----------------${NC}"
                    echo ""
                    lxc exec "$VM_NAME" --project "$LXD_PROJECT" -- bash -c "cat \$(ls -rt /var/log/cloud-init-output.log* 2>/dev/null) 2>/dev/null | tail -n 50 | sed 's/\r\$//; s/.*\r//; s/\x1b\[[0-9;?]*[A-Za-ln-z]//g'"
                    echo -ne "${NC}"
                    echo ""
                    echo -e "${BRED}--------------------------------------------------------------------------${NC}"
                    echo ""
                    echo "Connect using '${CMD_NAME} shell ${SYNTH_ID}' to debug what happened, or run '${CMD_NAME} destroy ${SYNTH_ID}' to clean up."
                    DEPLOY_FAILED=true
                    lxc project set "$LXD_PROJECT" user.synth.status="failed" 2>/dev/null || true
                    PHASE="DONE"
                    break
                elif [[ "$CI_STATUS" == *"status: done"* ]]; then
                    # Print the final status one last time cleanly
                    echo -e "${CURSOR_TOP}${BYELLOW}-> 5. Juju Deployment Status (Finalizing...)${NC}${CLR_EOL}"
                    echo -e "Target IP: $IP | Updated: $(date +%T)${CLR_EOL}"
                    echo -e "${BYELLOW}------------------------------ Juju Status -------------------------------${NC}${CLR_EOL}"
                    echo -e "$JUJU_OUTPUT" | sed "s/$/${CLR_EOL}/"
                    echo -ne "${CLEAR_REST}"
                    echo ""
                    echo -e "${BYELLOW}cloud-init finished successfully!${NC}"
                    PHASE="DONE"
                    break
                fi
                
                # Header
                UI_FRAME="${CURSOR_TOP}${BYELLOW}-> 5. Juju Deployment Status (cloud-init is running...)${NC}${CLR_EOL}\n"
                UI_FRAME+="Target IP: $IP | Updated: $(date +%T)${CLR_EOL}\n"
                
                # Dynamic Step Header
                if [ -n "$STEP_OUTPUT" ]; then
                    # Extract the core message without the existing dashes (fixed regex)
                    RAW_STEP=$(echo "$STEP_OUTPUT" | sed -E 's/.*-+ (.*) -+.*/\1/' | xargs)
                    
                    # Calculate padding to match the default header width (~66 characters)
                    TEXT_LEN=${#RAW_STEP}
                    PAD_LEN=$(( (74 - TEXT_LEN - 2) / 2 ))
                    [ "$PAD_LEN" -lt 8 ] && PAD_LEN=8
                    PADDING=$(printf '%*s' "$PAD_LEN" '' | tr ' ' '-')
                    UI_FRAME+="${BYELLOW}${PADDING} ${RAW_STEP} ${PADDING}${NC}${CLR_EOL}\n"
                else
                    UI_FRAME+="${BYELLOW}------------------------ Latest $CLOUD_INIT_LOG_LINES cloud-init Logs ------------------------${NC}${CLR_EOL}\n"
                fi
                
                # Tail $CLOUD_INIT_LOG_LINES lines of cloud-init logs
                if [ -n "$LOG_OUTPUT" ]; then
                    UI_FRAME+=$(echo -e "$LOG_OUTPUT" | sed "s/$/${CLR_EOL}/")
                    UI_FRAME+="\n"
                else
                    UI_FRAME+="(Waiting for logs...)${CLR_EOL}\n"
                fi
                
                UI_FRAME+="${BYELLOW}------------------------------ Juju Status -------------------------------${NC}${CLR_EOL}\n"
                
                # Read live terminal height from the side-channel file updated by the parent poller
                if [ -f "$TERM_SIZE_FILE" ]; then
                    LIVE_HEIGHT=$(cat "$TERM_SIZE_FILE" 2>/dev/null)
                    USER_TERM_HEIGHT=${LIVE_HEIGHT:-$USER_TERM_HEIGHT}
                fi
                
                # Reserve lines for cloud-init logs + header (4) + a safety buffer (2)
                MAX_JUJU_LINES=$(( USER_TERM_HEIGHT - ( 4 + CLOUD_INIT_LOG_LINES ) - 2 ))
                if [ "$MAX_JUJU_LINES" -lt 10 ]; then MAX_JUJU_LINES=10; fi
                
                JUJU_LINE_COUNT=$(echo "$JUJU_OUTPUT" | wc -l)
                
                # Print Juju output: Truncate if it exceeds available terminal lines
                if [ "$JUJU_LINE_COUNT" -gt "$MAX_JUJU_LINES" ]; then
                    HIDDEN_LINES=$(( JUJU_LINE_COUNT - MAX_JUJU_LINES ))
                    UI_FRAME+=$(echo -e "$JUJU_OUTPUT" | head -n "$MAX_JUJU_LINES" | sed "s/$/${CLR_EOL}/")
                    UI_FRAME+="\n... [ Output truncated by $HIDDEN_LINES lines to fit terminal ] ...${CLR_EOL}\n"
                else
                    UI_FRAME+=$(echo -e "$JUJU_OUTPUT" | sed "s/$/${CLR_EOL}/")
                    UI_FRAME+="\n"
                fi
                
                # Clear whatever is left at the very bottom of the screen (in case list got shorter)
                UI_FRAME+="${CLEAR_REST}"
                echo -ne "$UI_FRAME"
            else
                # If SSH fails, just print a warning on top, don't wipe screen
                echo -ne "${CURSOR_TOP}${BYELLOW}Connection lost. Reconnecting...${NC}${CLR_EOL}\r"
            fi
            
            # Standard refresh rate
            sleep 2
        fi
    done
    # Force cursor to reappear
    echo -e "\033[?25h"
    
    if [ "$DEPLOY_FAILED" = true ]; then
        if [ -n "$TAIL_PID" ]; then
            kill "$TAIL_PID" 2>/dev/null || true
        fi
        exit 1
    fi
    
    # ==========================================
    # HORIZON DASHBOARD
    # ==========================================
    
    if grep -q "custom_os_" "$CLOUD_INIT"; then
        echo ""
        echo -e "${BYELLOW}-> 6. Opening OpenStack Horizon Dashboard...${NC}"
        echo ""
        
        HORIZON_URL=""
        HORIZON_IP=""
        HORIZON_PORT="80"
        HORIZON_PATH="/horizon"
        
        OS_USERNAME=""
        OS_DOMAIN=""
        OS_PASSWORD=""
        
        # Try Sunbeam first
        SUNBEAM_URL=$(lxc exec "$VM_NAME" --project "$LXD_PROJECT" -- su - "$SYS_USER" -c "sunbeam dashboard url" 2>/dev/null)
        
        if [[ "$SUNBEAM_URL" == *"http"* ]]; then
            echo -e "  Sunbeam deployment detected..."
            echo ""
            
            # Extract the raw URL string from the command output
            HORIZON_URL=$(echo "$SUNBEAM_URL" | grep -oP 'https?://[^ ]+')
            
            # Extract the hostname, port, and path from the URL
            read -r HORIZON_IP HORIZON_PORT HORIZON_PATH <<< "$(python3 -c "
import urllib.parse, sys
try:
    url = sys.argv[1]
    parsed = urllib.parse.urlparse(url)
    port = parsed.port or (443 if parsed.scheme == 'https' else 80)
    print(f'{parsed.hostname} {port} {parsed.path}')
except Exception:
    pass
" "$HORIZON_URL")"
            
            # If HORIZON_IP is a hostname instead of an IPv4 address, resolve it
            if [ -n "$HORIZON_IP" ] && ! [[ "$HORIZON_IP" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
                RESOLVED_IP=$(lxc exec "$VM_NAME" --project "$LXD_PROJECT" -- getent hosts "$HORIZON_IP" | awk '{print $1}' | head -n 1)
                if [ -n "$RESOLVED_IP" ]; then
                    HORIZON_IP="$RESOLVED_IP"
                fi
            fi
            
            # Fetch Sunbeam credentials
            SUNBEAM_RC=$(lxc exec "$VM_NAME" --project "$LXD_PROJECT" -- su - "$SYS_USER" -c "sunbeam openrc 2>/dev/null")
            
            # Extract values, stripping quotes, single quotes, and carriage returns safely
            TMP_USER=$(echo "$SUNBEAM_RC" | grep -oP 'OS_USERNAME=\K.*' | tr -d "'\"\r")
            TMP_PASS=$(echo "$SUNBEAM_RC" | grep -oP 'OS_PASSWORD=\K.*' | tr -d "'\"\r")
            TMP_DOM=$(echo "$SUNBEAM_RC" | grep -oP 'OS_USER_DOMAIN_NAME=\K.*' | tr -d "'\"\r")
            
            [ -n "$TMP_USER" ] && OS_USERNAME="$TMP_USER"
            [ -n "$TMP_PASS" ] && OS_PASSWORD="$TMP_PASS"
            [ -n "$TMP_DOM" ] && OS_DOMAIN="$TMP_DOM"
        else
            # Try charmed OpenStack
            
            # Identify the target model from the JUJU_MODELS string (grab the first word)
            TARGET_MODEL=$(echo "$JUJU_MODELS" | awk '{print $1}')
            [ -z "$TARGET_MODEL" ] && TARGET_MODEL="openstack"
            
            HORIZON_IP=$(lxc exec "$VM_NAME" --project "$LXD_PROJECT" -- su - "$SYS_USER" -c "juju status -m $TARGET_MODEL openstack-dashboard --format json" 2>/dev/null | jq -r '.applications["openstack-dashboard"].units | to_entries[0].value["public-address"]' 2>/dev/null)
            
            if [ -n "$HORIZON_IP" ] && [ "$HORIZON_IP" != "null" ]; then
                echo -e "  Charmed OpenStack deployment detected..."
                echo ""
                
                # Override IP if a Dashboard VIP is configured
                VIP=$(lxc exec "$VM_NAME" --project "$LXD_PROJECT" -- su - "$SYS_USER" -c "juju config -m $TARGET_MODEL openstack-dashboard vip 2>/dev/null")
                if [ -n "$VIP" ] && [ "$VIP" != "null" ]; then
                    # Grab the first IP if it happens to be a comma-separated list
                    HORIZON_IP=$(echo "$VIP" | awk -F, '{print $1}' | tr -d ' ')
                fi
                
                HORIZON_URL="http://${HORIZON_IP}${HORIZON_PATH}"
                
                # Fetch charmed OpenStack credentials
                OPENRC=$(lxc exec "$VM_NAME" --project "$LXD_PROJECT" -- cat /home/"$SYS_USER"/openrc 2>/dev/null)
                if [ -n "$OPENRC" ]; then
                    TMP_USER=$(echo "$OPENRC" | grep -oP 'OS_USERNAME=\K.*' | tr -d "'\"\r")
                    [ -n "$TMP_USER" ] && OS_USERNAME="$TMP_USER"
                    
                    TMP_DOM=$(echo "$OPENRC" | grep -oP 'OS_USER_DOMAIN_NAME=\K.*' | tr -d "'\"\r")
                    [ -n "$TMP_DOM" ] && OS_DOMAIN="$TMP_DOM"
                fi
                
                # Fallback Domain via Keystone config if missing from openrc
                if [ -z "$OS_DOMAIN" ]; then
                    TMP_DOM=$(lxc exec "$VM_NAME" --project "$LXD_PROJECT" -- su - "$SYS_USER" -c "juju config -m $TARGET_MODEL keystone admin-domain-name 2>/dev/null" | tr -d '\r')
                    [ -n "$TMP_DOM" ] && [ "$TMP_DOM" != "null" ] && OS_DOMAIN="$TMP_DOM"
                fi
                
                # Get admin password via Keystone
                ACTION_CMD="juju run -m $TARGET_MODEL keystone/leader get-admin-password 2>/dev/null || juju run-action -m $TARGET_MODEL keystone/leader get-admin-password --wait 2>/dev/null"
                TMP_PASS=$(lxc exec "$VM_NAME" --project "$LXD_PROJECT" -- su - "$SYS_USER" -c "$ACTION_CMD" | grep -oP 'admin-password:\s*\K\S+' | head -n 1 | tr -d '\r')
                [ -n "$TMP_PASS" ] && [ "$TMP_PASS" != "null" ] && OS_PASSWORD="$TMP_PASS"
            fi
        fi
        
        if [ -n "$HORIZON_IP" ] && [ "$HORIZON_IP" != "null" ]; then
            
            # Apply standard fallbacks just in case the extraction files were empty
            [ -z "$OS_USERNAME" ] && OS_USERNAME="admin"
            [ -z "$OS_DOMAIN" ] && OS_DOMAIN="admin_domain"
            
            echo -e "${BYELLOW}  --- Login Credentials ---${NC}"
            echo -e "${BYELLOW}  Username: ${NC}${OS_USERNAME}"
            if [ -n "$OS_PASSWORD" ]; then
                echo -e "${BYELLOW}  Password: ${NC}${OS_PASSWORD}"
            else
                echo -e "${BYELLOW}  Password: ${NC}${BRED}(Could not fetch automatically)${NC}"
            fi
            echo -e "${BYELLOW}  Domain:   ${NC}${OS_DOMAIN}"
            echo ""
            
            # Append to access file
            {
                echo "[ OpenStack Horizon Dashboard ]"
                echo "  Username: ${OS_USERNAME}"
                echo "  Password: ${OS_PASSWORD:-(Could not fetch automatically)}"
                echo "  Domain:   ${OS_DOMAIN}"
            } >> "$ACCESS_FILE"
            
            if [ -n "$SSH_CLIENT" ] || [ -n "$SSH_TTY" ] || [ -n "$SSH_CONNECTION" ]; then
                REMOTE_USER=$(whoami)
                SERVER_IP_GUESS=$(echo "${SSH_CONNECTION:-}" | awk '{print $3}')
                SERVER_IP_STR=${SERVER_IP_GUESS:-<SERVER_IP>}
                
                echo -e "${BYELLOW}  Remote SSH Session Detected!${NC}"
                echo "  To access the Horizon dashboard locally, open a new terminal tab on your host and run:"
                echo ""
                echo -e "${BYELLOW}  Run:${NC} ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -N -L ${HORIZON_LOCAL_PORT}:${HORIZON_IP}:${HORIZON_PORT} ${REMOTE_USER}@${SERVER_IP_STR}"
                echo -e "${BYELLOW}  URL:${NC} http://localhost:${HORIZON_LOCAL_PORT}${HORIZON_PATH}"
                echo ""
                
                # Append to access file
                {
                    echo "  Tunnel:   ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -N -L ${HORIZON_LOCAL_PORT}:${HORIZON_IP}:${HORIZON_PORT} ${REMOTE_USER}@${SERVER_IP_STR}"
                    echo "  URL:      http://localhost:${HORIZON_LOCAL_PORT}${HORIZON_PATH}"
                    echo ""
                } >> "$ACCESS_FILE"
                
                pause_to_continue "Press Enter to drop into the final interactive shell..."
            else
                echo -e "${BYELLOW}  Horizon Dashboard:${NC} $HORIZON_URL"
                echo ""
                
                # Append to access file
                {
                    echo "  URL:      $HORIZON_URL"
                    echo ""
                } >> "$ACCESS_FILE"
                
                echo -e "${BYELLOW}  Local session detected. Opening Horizon Dashboard...${NC}"
                if command -v xdg-open &> /dev/null; then
                    xdg-open "$HORIZON_URL" > /dev/null 2>&1 &
                fi
            fi
        else
            echo -e "  ${BRED}Could not automatically determine the Horizon URL/IP.${NC}"
            echo "  (The dashboard unit may not be deployed or is still initializing)."
        fi
    else
        echo ""
        echo -e "${BYELLOW}-> 6. Skipping Horizon Dashboard... (no OpenStack detected)${NC}"
    fi
    
    # ==========================================
    # CLUSTER IP INVENTORY
    # ==========================================
    
    echo ""
    echo -e "${BYELLOW}==========================================${NC}"
    echo -e "${BYELLOW} Cluster Instances & Access Info${NC}"
    echo -e "${BYELLOW}==========================================${NC}"
    echo ""
    print_cluster_inventory "all"
    
    # Mark deployment as completed in LXD project metadata
    lxc project set "$LXD_PROJECT" user.synth.status="deployed" 2>/dev/null || true
    
    # Kill the tail process
    if [ -n "$TAIL_PID" ]; then
        kill "$TAIL_PID" 2>/dev/null || true
    fi
    
    # Write the connection string directly to the log out in case the terminal detached
    {
        TOTAL_TIME=$SECONDS
        HOURS=$(( TOTAL_TIME / 3600 ))
        MINS=$(( (TOTAL_TIME % 3600) / 60 ))
        SECS=$(( TOTAL_TIME % 60 ))
        
        if [ $HOURS -gt 0 ]; then
            TIME_STR="${HOURS}h ${MINS}m ${SECS}s"
        else
            TIME_STR="${MINS}m ${SECS}s"
        fi
        
        echo ""
        echo -e "${BYELLOW}-> 7. Deployment completed in ${NC}${TIME_STR}${BYELLOW}! Connect to your environment using:${NC}"
        echo "  ${CMD_NAME} shell ${SYNTH_ID}"
        echo "  (or directly: ssh ${SSH_OPTS[*]} ${SYS_USER}@$IP)"
        echo ""
    } >> "$LOG_FILE"
) &
WORKER_PID=$!
lxc project set "$LXD_PROJECT" user.synth.worker_pid="$WORKER_PID" 2>/dev/null || true

# Wait for the background worker to finish naturally
wait $WORKER_PID
WORKER_EXIT_CODE=$?

# Stop the size poller loop and remove side-channel file after poller has exited
stop_poller_and_clean

# Kill the tail process (fails silently since the worker already did it)
if [ -n "$TAIL_PID" ]; then
    kill "$TAIL_PID" 2>/dev/null || true
fi

# Restore stdout/stderr back to the terminal
exec 1>&3 2>&4

# If we get here, the user DID NOT interrupt (Ctrl+C). Restore normal traps
trap 'emergency_rollback; exit 1' INT TERM HUP

# Abort the parent if the worker failed
if [ $WORKER_EXIT_CODE -ne 0 ]; then
    echo -e "${BRED}Deployment process failed or was aborted.${NC}"
    echo "Connect with '${CMD_NAME} shell ${SYNTH_ID}' to debug or '${CMD_NAME} destroy ${SYNTH_ID}' to clean up."
    exit $WORKER_EXIT_CODE
fi

# Fetch the IP directly from LXD since we are in the parent shell and the worker has finished
IP=$(get_vm_ipv4 "$LXD_PROJECT" "$VM_NAME")

# ==========================================
# FINAL SSH SHELL
# ==========================================

if [ -n "$IP" ]; then
    TOTAL_TIME=$SECONDS
    HOURS=$(( TOTAL_TIME / 3600 ))
    MINS=$(( (TOTAL_TIME % 3600) / 60 ))
    SECS=$(( TOTAL_TIME % 60 ))
    
    if [ $HOURS -gt 0 ]; then
        TIME_STR="${HOURS}h ${MINS}m ${SECS}s"
    else
        TIME_STR="${MINS}m ${SECS}s"
    fi
    
    echo ""
    echo -e "${BYELLOW}-> 7. Deployment completed in ${NC}${TIME_STR}${BYELLOW}! Dropping into interactive shell...${NC}"
    echo ""
    
    # shellcheck disable=SC2029
    ssh "${SSH_OPTS[@]}" "${SYS_USER}@$IP"
fi

# ==========================================
# DONE
# ==========================================
