cmd_list() {
    split_short_flags "$@"
    set -- ${PARSED_ARGS[@]+"${PARSED_ARGS[@]}"}
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                cat << EOF
Usage: $CMD_NAME list

List all synth-managed LXD environments, their persistent IDs, primary VM IPs, and current deployment status.

Aliases: ls
EOF
                exit 0
                ;;
            -*)
                echo -e "${BRED}Error: Unknown flag '${NC}${1}${BRED}' for list command.${NC}"
                exit 1
                ;;
            *)
                echo -e "${BRED}Error: Unexpected argument '${NC}${1}${BRED}' for list command.${NC}"
                exit 1
                ;;
        esac
    done
    
    local projects_json
    projects_json=$(lxc project list --format json 2>/dev/null)
    
    if [ -z "$projects_json" ]; then
        echo -e "${BRED}Error: Unable to query LXD projects.${NC}"
        exit 1
    fi
    
    local managed_rows
    managed_rows=$(echo "$projects_json" | jq -r '
        [ .[] | select(.config["user.synth.managed"]=="true") ] |
        sort_by((.config["user.synth.id"] // "999999") | tonumber) |
        .[] | [
            (.config["user.synth.id"] // "-"),
            (.config["user.synth.deploy_id"] // "-"),
            .name,
            (.config["user.synth.repro"] // "-" | ascii_downcase),
            (.config["user.synth.primary_vm"] // "-"),
            (.config["user.synth.status"] // "unknown"),
            (.config["user.synth.worker_pid"] // "")
        ] | @tsv
    ')
    
    if [ -z "$managed_rows" ]; then
        echo ""
        echo -e "${BYELLOW}No active synth environments found.${NC}"
        echo ""
        exit 0
    fi
    
    local table_data=""
    while IFS=$'\t' read -r id deploy_id proj repro primary_vm status worker_pid; do
        # Verify background worker is still alive if status is 'deploying'
        if [ "$status" = "deploying" ] && [ -n "$worker_pid" ]; then
            if [ ! -d "/proc/$worker_pid" ]; then
                local latest_status
                latest_status=$(lxc project get "$proj" user.synth.status 2>/dev/null || echo "failed")
                if [ "$latest_status" = "deploying" ]; then
                    status="failed"
                    lxc project set "$proj" user.synth.status="failed" 2>/dev/null || true
                else
                    status="$latest_status"
                fi
            fi
        fi
        
        local ip_addr
        ip_addr=$(get_vm_ipv4 "$proj" "$primary_vm")
        [ -z "$ip_addr" ] && ip_addr="-"
        
        table_data+="${id}"$'\t'"${deploy_id}"$'\t'"${proj}"$'\t'"${repro}"$'\t'"${primary_vm}"$'\t'"${ip_addr}"$'\t'"${status}"$'\n'
    done <<< "$managed_rows"
    
    local use_color="0"
    [ -t 1 ] && use_color="1"
    
    echo ""
    printf '%s' "$table_data" | python3 -c '
import sys

use_color = sys.argv[1] == "1"
BGREEN = "\033[1;32m" if use_color else ""
BYELLOW = "\033[1;33m" if use_color else ""
BRED = "\033[1;31m" if use_color else ""
NC = "\033[0m" if use_color else ""

headers = ["ID", "Deploy ID", "Project", "Type", "Primary VM", "IP Address", "Status"]
rows = [line.rstrip("\n").split("\t") for line in sys.stdin if line.strip()]

widths = [len(h) for h in headers]
for r in rows:
    for i, cell in enumerate(r[:len(headers)]):
        widths[i] = max(widths[i], len(cell))

sep = "+" + "+".join("-" * (w + 2) for w in widths) + "+"

def fmt_row(cells, is_header=False):
    parts = []
    for i, w in enumerate(widths):
        val = cells[i] if i < len(cells) else ""
        padded = f" {val:<{w}} "
        if is_header and use_color:
            padded = f"{BYELLOW}{padded}{NC}"
        elif not is_header and i == 6 and use_color:
            color = {"deployed": BGREEN, "deploying": BYELLOW, "failed": BRED}.get(val, "")
            if color:
                padded = f" {color}{val:<{w}}{NC} "
        parts.append(padded)
    return "|" + "|".join(parts) + "|"

print(sep)
print(fmt_row(headers, is_header=True))
print(sep)
for r in rows:
    print(fmt_row(r))
print(sep)
' "$use_color"
    echo ""
    exit 0
}

cmd_monitor() {
    local target=""
    local tail_lines="10"
    
    split_short_flags "$@"
    set -- ${PARSED_ARGS[@]+"${PARSED_ARGS[@]}"}
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                cat << EOF
Usage: $CMD_NAME monitor <id|deploy_id|project> [OPTIONS]

Tail the last 10 lines of a lab's deployment log and stream live while deploying.
For completed or failed labs, displays the tail of the log and exits.
Press Ctrl+C at any time to detach without interrupting the background deployment.

Options:
  -n, --lines <N>       Show the last N lines (default: 10).
  -a, --all             Show the entire log file from the beginning.
  -h, --help            Show this help message and exit.

Aliases: logs, log
EOF
                exit 0
                ;;
            -a|--all)
                tail_lines="+1"
                shift 1
                ;;
            -n|--lines)
                if [[ -n "$2" && "$2" =~ ^[0-9]+$ ]]; then
                    tail_lines="$2"
                    shift 2
                else
                    echo -e "${BRED}Error: $1 requires a numeric line count.${NC}"
                    exit 1
                fi
                ;;
            -*)
                echo -e "${BRED}Error: Unknown flag '${NC}${1}${BRED}' for monitor command.${NC}"
                exit 1
                ;;
            *)
                if [ -z "$target" ]; then
                    target="$1"
                    shift 1
                else
                    echo -e "${BRED}Error: Unexpected extra argument '${NC}${1}${BRED}'.${NC}"
                    exit 1
                fi
                ;;
        esac
    done
    
    local proj
    proj=$(resolve_lab "$target") || exit 1
    
    local lab_id status worker_pid log_file
    lab_id=$(lxc project get "$proj" user.synth.id 2>/dev/null)
    status=$(lxc project get "$proj" user.synth.status 2>/dev/null)
    worker_pid=$(lxc project get "$proj" user.synth.worker_pid 2>/dev/null)
    log_file=$(lxc project get "$proj" user.synth.log_file 2>/dev/null)
    
    if [ "$status" = "deploying" ] && [ -n "$worker_pid" ] && [ ! -d "/proc/$worker_pid" ]; then
        status=$(lxc project get "$proj" user.synth.status 2>/dev/null || echo "failed")
        if [ "$status" = "deploying" ]; then
            status="failed"
            lxc project set "$proj" user.synth.status="failed" 2>/dev/null || true
        fi
    fi
    
    local status_color
    status_color=$(get_status_color "$status")
    
    if [ -z "$log_file" ] || [ ! -f "$log_file" ]; then
        echo -e "${BRED}Error: Log file not found for lab #${lab_id} (${NC}${proj}${BRED}).${NC}"
        exit 1
    fi
    
    trap '
        echo -ne "\033[?25h"
        echo ""
        echo -e "${BYELLOW}-> Detached from monitor. Background deployment is unaffected.${NC}"
        echo ""
        exit 0
    ' INT TERM
    
    echo ""
    if [ "$status" = "deploying" ] && [ -n "$worker_pid" ] && [ -d "/proc/$worker_pid" ]; then
        echo -e "${BYELLOW}-> Monitoring live deployment for lab #${lab_id} (${NC}${proj}${BYELLOW}) [Ctrl+C to detach]...${NC}"
        echo ""
        sleep 5
        tail -n "$tail_lines" -f --pid="$worker_pid" "$log_file"
        echo -ne "\033[?25h"
    else
        echo -e "${BYELLOW}-> Showing deployment log for lab #${lab_id} (${NC}${proj}${BYELLOW} | Status: ${status_color}${status}${BYELLOW}):${NC}"
        echo ""
        sleep 5
        tail -n "$tail_lines" "$log_file"
    fi
    exit 0
}

cmd_shell() {
    local target=""
    local force_lxc=false
    
    split_short_flags "$@"
    set -- ${PARSED_ARGS[@]+"${PARSED_ARGS[@]}"}
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                cat << EOF
Usage: $CMD_NAME shell <id|deploy_id|project> [OPTIONS]

Connect to a lab's primary VM via SSH using the configured key and user.
Automatically falls back to 'lxc shell' if the VM has no IP yet or SSH is unreachable.

Options:
  --lxc                 Skip SSH and connect directly via 'lxc shell'.
  -h, --help            Show this help message and exit.

Aliases: connect, ssh
EOF
                exit 0
                ;;
            --lxc)
                force_lxc=true
                shift 1
                ;;
            -*)
                echo -e "${BRED}Error: Unknown flag '${NC}${1}${BRED}' for shell command.${NC}"
                exit 1
                ;;
            *)
                if [ -z "$target" ]; then
                    target="$1"
                    shift 1
                else
                    echo -e "${BRED}Error: Unexpected extra argument '${NC}${1}${BRED}'.${NC}"
                    exit 1
                fi
                ;;
        esac
    done
    
    local proj
    proj=$(resolve_lab "$target") || exit 1
    
    local primary_vm sys_user ssh_key
    primary_vm=$(lxc project get "$proj" user.synth.primary_vm 2>/dev/null)
    sys_user=$(lxc project get "$proj" user.synth.sys_user 2>/dev/null)
    sys_user="${sys_user:-ubuntu}"
    ssh_key=$(lxc project get "$proj" user.synth.ssh_key 2>/dev/null)
    
    local vm_state
    vm_state=$(lxc list "$primary_vm" --project "$proj" --format json 2>/dev/null | jq -r '.[0].status // empty')
    
    if [ -z "$vm_state" ]; then
        echo -e "${BRED}Error: Primary VM '${NC}${primary_vm}${BRED}' not found in project '${NC}${proj}${BRED}'.${NC}"
        exit 1
    elif [ "$vm_state" != "Running" ]; then
        echo -e "${BRED}Error: Primary VM '${NC}${primary_vm}${BRED}' is currently '${NC}${vm_state}${BRED}'.${NC}"
        echo "Start it with: lxc start $primary_vm --project $proj"
        exit 1
    fi
    
    echo ""
    if [ "$force_lxc" = true ]; then
        echo -e "${BYELLOW}-> Opening '${NC}lxc shell${BYELLOW}' into '${NC}${primary_vm}${BYELLOW}' (${NC}${proj}${BYELLOW})...${NC}"
        echo ""
        exec lxc shell "$primary_vm" --project "$proj"
    fi
    
    local ip_addr
    ip_addr=$(get_vm_ipv4 "$proj" "$primary_vm")
    
    local ssh_opts=()
    if [ -n "$ssh_key" ] && [ -f "$ssh_key" ]; then
        ssh_opts=(-i "$ssh_key" -o "StrictHostKeyChecking=no" -o "UserKnownHostsFile=/dev/null")
    else
        ssh_opts=(-o "StrictHostKeyChecking=no" -o "UserKnownHostsFile=/dev/null")
    fi
    
    if [ -n "$ip_addr" ]; then
        # Fast pre-flight check to verify SSH daemon and keys are ready
        if ssh -o ConnectTimeout=3 -o BatchMode=yes "${ssh_opts[@]}" "${sys_user}@${ip_addr}" true >/dev/null 2>&1; then
            echo -e "${BYELLOW}-> Connecting to '${NC}${proj}${BYELLOW}' (${NC}${sys_user}@${ip_addr}${BYELLOW}) via SSH...${NC}"
            echo ""
            exec ssh "${ssh_opts[@]}" "${sys_user}@${ip_addr}"
        else
            echo -e "${BYELLOW}-> SSH to '${NC}${sys_user}@${ip_addr}${BYELLOW}' is not ready or failed. Falling back to '${NC}lxc shell${BYELLOW}'...${NC}"
            echo ""
            exec lxc shell "$primary_vm" --project "$proj"
        fi
    else
        echo -e "${BYELLOW}-> Primary VM has no IPv4 address yet. Falling back to '${NC}lxc shell${BYELLOW}'...${NC}"
        echo ""
        exec lxc shell "$primary_vm" --project "$proj"
    fi
}

cmd_info() {
    local target=""
    
    split_short_flags "$@"
    set -- ${PARSED_ARGS[@]+"${PARSED_ARGS[@]}"}
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                cat << EOF
Usage: $CMD_NAME info <id|deploy_id|project>

Display access details, SSH commands, SSH port-forwarding tunnels, and dashboard credentials for a lab.
EOF
                exit 0
                ;;
            -*)
                echo -e "${BRED}Error: Unknown flag '${NC}${1}${BRED}' for info command.${NC}"
                exit 1
                ;;
            *)
                if [ -z "$target" ]; then
                    target="$1"
                    shift 1
                else
                    echo -e "${BRED}Error: Unexpected extra argument '${NC}${1}${BRED}'.${NC}"
                    exit 1
                fi
                ;;
        esac
    done
    
    local proj
    proj=$(resolve_lab "$target") || exit 1
    
    local lab_id deploy_id status worker_pid primary_vm sys_user ssh_key access_file log_file config_file
    lab_id=$(lxc project get "$proj" user.synth.id 2>/dev/null)
    deploy_id=$(lxc project get "$proj" user.synth.deploy_id 2>/dev/null)
    status=$(lxc project get "$proj" user.synth.status 2>/dev/null)
    worker_pid=$(lxc project get "$proj" user.synth.worker_pid 2>/dev/null)
    primary_vm=$(lxc project get "$proj" user.synth.primary_vm 2>/dev/null)
    sys_user=$(lxc project get "$proj" user.synth.sys_user 2>/dev/null)
    sys_user="${sys_user:-ubuntu}"
    ssh_key=$(lxc project get "$proj" user.synth.ssh_key 2>/dev/null)
    access_file=$(lxc project get "$proj" user.synth.access_file 2>/dev/null)
    log_file=$(lxc project get "$proj" user.synth.log_file 2>/dev/null)
    config_file=$(lxc project get "$proj" user.synth.config_file 2>/dev/null)
    
    if [ "$status" = "deploying" ] && [ -n "$worker_pid" ] && [ ! -d "/proc/$worker_pid" ]; then
        status=$(lxc project get "$proj" user.synth.status 2>/dev/null || echo "failed")
        if [ "$status" = "deploying" ]; then
            status="failed"
            lxc project set "$proj" user.synth.status="failed" 2>/dev/null || true
        fi
    fi
    
    local status_color
    status_color=$(get_status_color "$status")
    
    echo ""
    echo -e "${BYELLOW}Lab #${lab_id} (${NC}${proj}${BYELLOW} | ID: ${NC}${deploy_id}${BYELLOW} | Status: ${status_color}${status}${BYELLOW})${NC}"
    [ -n "$log_file" ] && [ -f "$log_file" ] && echo -e "${BYELLOW}Log File:${NC}    $log_file"
    [ -n "$config_file" ] && [ -f "$config_file" ] && echo -e "${BYELLOW}Config File:${NC} $config_file"
    echo ""
    
    if [ -n "$access_file" ] && [ -f "$access_file" ]; then
        cat "$access_file"
    else
        local ip_addr
        ip_addr=$(get_vm_ipv4 "$proj" "$primary_vm")
        local ssh_cmd="ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
        [ -n "$ssh_key" ] && [ -f "$ssh_key" ] && ssh_cmd="ssh -i $ssh_key -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
        
        echo "=========================================="
        echo " Access Details for ${proj}"
        echo "=========================================="
        echo ""
        echo "[ LXD Web UI ]"
        echo "  URL:      https://localhost:8443/ui/project/${proj}/instances"
        echo ""
        echo "[ SSH Access - Primary VM ]"
        if [ -n "$ip_addr" ]; then
            echo "  ${ssh_cmd} ${sys_user}@${ip_addr}"
        else
            echo "  (Waiting for Primary VM IP address — use '$CMD_NAME shell ${lab_id}' for lxc shell)"
        fi
        echo ""
    fi
    exit 0
}

cmd_destroy() {
    local target=""
    local skip_confirm=false
    local remove_all=false
    
    split_short_flags "$@"
    set -- ${PARSED_ARGS[@]+"${PARSED_ARGS[@]}"}
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                cat << EOF
Usage: $CMD_NAME destroy <id|deploy_id|project> [OPTIONS]

Tear down a managed lab, terminating any active background worker and deleting its LXD project,
instances, custom volumes, dynamic bridges, DNS records, volatile certificates, and log/access files.

Options:
  -y, --yes             Skip confirmation prompt and destroy immediately.
  -a, --all             Also remove the saved deployment configuration file (config-*.yaml).
  -h, --help            Show this help message and exit.

Aliases: rm, delete
EOF
                exit 0
                ;;
            -y|--yes)
                skip_confirm=true
                shift 1
                ;;
            -a|--all)
                remove_all=true
                shift 1
                ;;
            -*)
                echo -e "${BRED}Error: Unknown flag '${NC}${1}${BRED}' for destroy command.${NC}"
                exit 1
                ;;
            *)
                if [ -z "$target" ]; then
                    target="$1"
                    shift 1
                else
                    echo -e "${BRED}Error: Unexpected extra argument '${NC}${1}${BRED}'.${NC}"
                    exit 1
                fi
                ;;
        esac
    done
    
    local proj
    proj=$(resolve_lab "$target") || exit 1
    
    local lab_id worker_pid primary_vm lxd_pool shared_images
    local primary_bridge primary_bridge_created primary_static_ip created_bridges_csv
    local volatile_cert project_dir access_file log_file config_file term_size_file
    
    lab_id=$(lxc project get "$proj" user.synth.id 2>/dev/null)
    worker_pid=$(lxc project get "$proj" user.synth.worker_pid 2>/dev/null)
    primary_vm=$(lxc project get "$proj" user.synth.primary_vm 2>/dev/null)
    lxd_pool=$(lxc project get "$proj" user.synth.lxd_pool 2>/dev/null)
    lxd_pool="${lxd_pool:-default}"
    shared_images=$(lxc project get "$proj" user.synth.shared_images 2>/dev/null)
    primary_bridge=$(lxc project get "$proj" user.synth.primary_bridge 2>/dev/null)
    primary_bridge_created=$(lxc project get "$proj" user.synth.primary_bridge_created 2>/dev/null)
    primary_static_ip=$(lxc project get "$proj" user.synth.primary_static_ip 2>/dev/null)
    created_bridges_csv=$(lxc project get "$proj" user.synth.created_bridges 2>/dev/null)
    volatile_cert=$(lxc project get "$proj" user.synth.volatile_cert 2>/dev/null)
    project_dir=$(lxc project get "$proj" user.synth.project_dir 2>/dev/null)
    access_file=$(lxc project get "$proj" user.synth.access_file 2>/dev/null)
    log_file=$(lxc project get "$proj" user.synth.log_file 2>/dev/null)
    config_file=$(lxc project get "$proj" user.synth.config_file 2>/dev/null)
    term_size_file="${project_dir:+${project_dir}/.term_size}"
    
    if [ "$skip_confirm" = false ]; then
        echo ""
        if [ "$remove_all" = true ]; then
            echo -ne "${BYELLOW}Destroy lab #${lab_id} (${NC}${proj}${BYELLOW}) and all its resources (including config file)? [y/N]: ${NC}"
        else
            echo -ne "${BYELLOW}Destroy lab #${lab_id} (${NC}${proj}${BYELLOW}) and all its resources? [y/N]: ${NC}"
        fi
        read -r confirm_input </dev/tty
        if [[ ! "$confirm_input" =~ ^[Yy]$ ]]; then
            echo ""
            echo -e "${BRED}Action aborted by user. Exiting.${NC}"
            exit 1
        fi
    fi
    
    echo ""
    echo -e "${BYELLOW}----- Starting Cleanup for Lab #${lab_id} (${NC}${proj}${BYELLOW}) -----${NC}"
    echo ""
    
    # 1. Terminate active background worker first so it does not race with instance deletion
    if [ -n "$worker_pid" ]; then
        echo -e "${BYELLOW}-> Checking background worker process (${NC}${worker_pid}${BYELLOW})...${NC}"
        echo ""
        if [ -d "/proc/$worker_pid" ]; then
            kill -9 "$worker_pid" 2>/dev/null || sudo kill -9 "$worker_pid" 2>/dev/null || true
            sleep 0.5
            if [ ! -d "/proc/$worker_pid" ]; then
                echo "Background worker process ($worker_pid) forcibly terminated."
            else
                echo -e "${BRED}Warning: Could not terminate background worker process ($worker_pid).${NC}"
            fi
        else
            echo "Background worker process ($worker_pid) is not running."
        fi
        echo ""
    fi
    
    # 2. Purge LXD project instances, custom volumes, isolated images, and project
    echo -e "${BYELLOW}-> Cleaning up dedicated LXD project:${NC} $proj"
    echo ""
    if lxc project list --format csv 2>/dev/null | cut -d',' -f1 | grep -qx "$proj"; then
        echo "Stopping and deleting all instances in project '$proj'..."
        for inst in $(lxc list --project "$proj" --format json 2>/dev/null | jq -r '.[].name'); do
            local attempts=0
            local max_attempts=6

            while lxc list --project "$proj" --format csv -c n 2>/dev/null | grep -qx "${inst}"; do
                if [ $attempts -ge $max_attempts ]; then
                    echo ""
                    echo -e "${BRED}Error: Instance '$inst' is stuck and refused to delete.${NC}"
                    echo "Please run 'sudo snap restart lxd' to break the deadlock, then run '$CMD_NAME destroy $lab_id' again."
                    exit 1
                fi
                
                [ $attempts -gt 0 ] && echo "Instance busy. Retrying deletion for '$inst' (Attempt $((attempts+1))/$max_attempts)..."
                
                lxc stop -f --project "$proj" "$inst" 2>/dev/null || true
                sleep 2
                lxc delete -f --project "$proj" "$inst" 2>/dev/null || true
                
                attempts=$((attempts + 1))
            done
        done
        
        sleep 2
        
        echo "Deleting storage volumes in project '$proj'..."
        for vol in $(lxc storage volume list "$lxd_pool" --project "$proj" --format json 2>/dev/null | jq -r '.[] | select(.type=="custom") | .name'); do
            lxc storage volume delete "$lxd_pool" "$vol" --project "$proj"
        done
        
        if [ "$shared_images" = "false" ]; then
            echo "Deleting images in project '$proj'..."
            for img in $(lxc image list --project "$proj" --format json 2>/dev/null | jq -r '.[].fingerprint'); do
                lxc image delete --project "$proj" "$img"
            done
        fi
        
        lxc project switch default 2>/dev/null || true
        lxc project delete "$proj"
    else
        echo "LXD project '$proj' not found, skipping..."
    fi
    echo ""
    
    # 3. Shared Primary Bridge DNS Cleanup
    if [ "$primary_bridge_created" = "false" ] && [ -n "$primary_bridge" ] && [ -n "$primary_vm" ] && [ -n "$primary_static_ip" ]; then
        echo -e "${BYELLOW}-> Cleaning up DNS records on shared Primary Bridge:${NC} $primary_bridge"
        echo ""
        if lxc network show "$primary_bridge" >/dev/null 2>&1; then
            local target_record="host-record=${primary_vm}.lxd,${primary_static_ip}"
            local current_dnsmasq
            current_dnsmasq=$(lxc network get "$primary_bridge" raw.dnsmasq 2>/dev/null || true)
            
            if echo "$current_dnsmasq" | grep -qF "$target_record"; then
                local new_dnsmasq
                new_dnsmasq=$(echo "$current_dnsmasq" | grep -vF "$target_record")
                if [ -z "$new_dnsmasq" ]; then
                    lxc network unset "$primary_bridge" raw.dnsmasq 2>/dev/null || true
                else
                    lxc network set "$primary_bridge" raw.dnsmasq="$new_dnsmasq" 2>/dev/null || true
                fi
                echo "DNS record removed from '$primary_bridge'."
                echo ""
            fi
        fi
    fi
    
    # 4. Dynamic Bridges Cleanup
    if [ -n "$created_bridges_csv" ]; then
        IFS=',' read -ra bridges_to_delete <<< "$created_bridges_csv"
        for br in "${bridges_to_delete[@]}"; do
            [ -z "$br" ] && continue
            echo -e "${BYELLOW}-> Deleting dynamic bridge:${NC} $br"
            echo ""
            if lxc network show "$br" >/dev/null 2>&1; then
                lxc network delete "$br"
            else
                echo "Bridge '$br' not found, skipping..."
            fi
            echo ""
        done
    fi
    
    # 5. Volatile LXD Certificate Cleanup
    if [ -n "$volatile_cert" ]; then
        local cert_name
        cert_name="$(basename "$volatile_cert")"
        echo -e "${BYELLOW}-> Removing LXD trust for volatile certificate:${NC} ${volatile_cert}"
        echo ""
        local fingerprint
        fingerprint=$(lxc config trust list --format json 2>/dev/null | jq -r ".[] | select(.name==\"${cert_name}\") | .fingerprint")
        
        if [ -n "$fingerprint" ] && [ "$fingerprint" != "null" ]; then
            lxc config trust remove "$fingerprint" 2>/dev/null || true
            echo "Certificate '${cert_name}' removed from trust store."
        else
            echo "Certificate '${cert_name}' not found in trust store, skipping..."
        fi
        rm -f "${volatile_cert}.crt" "${volatile_cert}.key"
        echo ""
    fi
    
    # 6. Local Files & Empty Directory Cleanup
    if [ -n "$access_file" ] && [ -f "$access_file" ]; then
        echo -e "${BYELLOW}-> Removing Access Info File:${NC} $access_file"
        echo ""
        rm -f "$access_file"
    fi
    
    if [ -n "$log_file" ] && [ -f "$log_file" ]; then
        echo -e "${BYELLOW}-> Removing Log File:${NC} $log_file"
        echo ""
        rm -f "$log_file"
    fi
    
    if [ "$remove_all" = true ] && [ -n "$config_file" ] && [ -f "$config_file" ]; then
        echo -e "${BYELLOW}-> Removing Configuration File:${NC} $config_file"
        echo ""
        rm -f "$config_file"
    fi
    
    if [ -n "$term_size_file" ] && [ -f "$term_size_file" ]; then
        rm -f "$term_size_file"
    fi
    
    if [ -n "$project_dir" ] && [ -d "$project_dir" ]; then
        rmdir "$project_dir" 2>/dev/null || true
    fi
    
    echo -e "${BYELLOW}-------------- Cleanup Complete --------------${NC}"
    echo ""
    exit 0
}

cmd_completion() {
    local action="bash"

    split_short_flags "$@"
    set -- ${PARSED_ARGS[@]+"${PARSED_ARGS[@]}"}

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                cat << EOF
Usage: $CMD_NAME completion [bash|install]

Generate or install Bash tab-completion for synth.

Actions:
  bash                  Print the Bash completion script to stdout (default).
  install               Install completion to ~/.local/share/bash-completion/completions/synth.
  -h, --help            Show this help message and exit.
EOF
                exit 0
                ;;
            bash|install)
                action="$1"
                shift 1
                ;;
            -*)
                echo -e "${BRED}Error: Unknown flag '${NC}${1}${BRED}' for completion command.${NC}"
                exit 1
                ;;
            *)
                echo -e "${BRED}Error: Unexpected argument '${NC}${1}${BRED}' for completion command.${NC}"
                exit 1
                ;;
        esac
    done

    local comp_script
    comp_script=$(cat << 'EOF'
_synth_lab_targets() {
    lxc project list --format json 2>/dev/null | jq -r '
        .[] | select(.config["user.synth.managed"]=="true") |
        (.config["user.synth.id"] // empty),
        (.config["user.synth.deploy_id"] // empty),
        .name
    ' 2>/dev/null
}

_synth_completions() {
    local cur prev subcmd=""
    local pos_count=0
    local i
    
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev=""
    [ "$COMP_CWORD" -gt 0 ] && prev="${COMP_WORDS[COMP_CWORD-1]}"
    
    for (( i=1; i<COMP_CWORD; i++ )); do
        case "${COMP_WORDS[i]}" in
            -i|--id|-c|--config|-m|--manifest|-n|--lines)
                ((i++))
                ;;
            -*)
                ;;
            *)
                if [ -z "$subcmd" ]; then
                    subcmd="${COMP_WORDS[i]}"
                else
                    ((pos_count++))
                fi
                ;;
        esac
    done
    
    case "$subcmd" in
        list|ls)
            COMPREPLY=( $(compgen -W "-h --help" -- "$cur") )
            return 0
            ;;
        monitor|logs|log)
            if [[ "$prev" == "-n" || "$prev" == "--lines" ]]; then
                COMPREPLY=( $(compgen -W "20 50 100 200" -- "$cur") )
            elif [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "-a --all -n --lines -h --help" -- "$cur") )
            elif [ "$pos_count" -eq 0 ]; then
                COMPREPLY=( $(compgen -W "$(_synth_lab_targets)" -- "$cur") )
            fi
            return 0
            ;;
        shell|connect|ssh)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "--lxc -h --help" -- "$cur") )
            elif [ "$pos_count" -eq 0 ]; then
                COMPREPLY=( $(compgen -W "$(_synth_lab_targets)" -- "$cur") )
            fi
            return 0
            ;;
        info)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "-h --help" -- "$cur") )
            elif [ "$pos_count" -eq 0 ]; then
                COMPREPLY=( $(compgen -W "$(_synth_lab_targets)" -- "$cur") )
            fi
            return 0
            ;;
        destroy|rm|delete)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "-y --yes -a --all -h --help" -- "$cur") )
            elif [ "$pos_count" -eq 0 ]; then
                COMPREPLY=( $(compgen -W "$(_synth_lab_targets)" -- "$cur") )
            fi
            return 0
            ;;
        completion)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "-h --help" -- "$cur") )
            elif [ "$pos_count" -eq 0 ]; then
                COMPREPLY=( $(compgen -W "bash install" -- "$cur") )
            fi
            return 0
            ;;
    esac
    
    case "$prev" in
        -c|--config|-m|--manifest)
            compopt -o filenames 2>/dev/null
            COMPREPLY=(
                $(compgen -f -X '!*.yaml' -- "$cur")
                $(compgen -f -X '!*.yml' -- "$cur")
                $(compgen -d -- "$cur")
            )
            return 0
            ;;
        -i|--id)
            return 0
            ;;
    esac
    
    if [[ "$cur" == -* ]]; then
        local deploy_opts="-h --help -y --yes -n --nested -d --deb -i --id -I --isolate-images -c --config -m --manifest"
        COMPREPLY=( $(compgen -W "$deploy_opts" -- "$cur") )
        return 0
    fi
    
    if [ -z "$subcmd" ]; then
        local cmds="list monitor shell info destroy completion"
        compopt -o filenames 2>/dev/null
        COMPREPLY=(
            $(compgen -W "$cmds" -- "$cur")
            $(compgen -f -X '!*.yaml' -- "$cur")
            $(compgen -f -X '!*.yml' -- "$cur")
            $(compgen -d -- "$cur")
        )
        return 0
    fi
}

complete -F _synth_completions synth ./synth
EOF
)
    
    if [ "$action" = "bash" ]; then
        printf '%s\n' "$comp_script"
        exit 0
    fi
    
    local comp_dir="${BASH_COMPLETION_USER_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/bash-completion}/completions"
    local comp_file="${comp_dir}/synth"
    
    mkdir -p "$comp_dir"
    printf '%s\n' "$comp_script" > "$comp_file"
    
    echo ""
    echo -e "${BYELLOW}-> Bash completion installed to:${NC} $comp_file"
    echo ""
    if ! command -v synth >/dev/null 2>&1; then
        echo -e "${BYELLOW}Note: '${NC}synth${BYELLOW}' is not in your \$PATH yet. To use '${NC}synth <TAB>${BYELLOW}' from anywhere, symlink it:${NC}"
        echo "  sudo ln -sf $(realpath "$0") /usr/local/bin/synth"
        echo ""
        echo -e "${BYELLOW}Or to enable completion for '${NC}./synth <TAB>${BYELLOW}' immediately, add this to ~/.bashrc:${NC}"
        echo "  source \"$comp_file\""
        echo ""
    else
        echo -e "Run 'exec bash' (or open a new terminal) to activate it."
        echo ""
    fi
    exit 0
}

