    echo -e "${BYELLOW}  Run:${NC} ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -N -L 8444:localhost:8443 ${REMOTE_USER}@${SERVER_IP_STR}"
    echo -e "${BYELLOW}  URL:${NC} https://localhost:8444/ui/project/${LXD_PROJECT}/instances"
    echo ""

    # Append to access file
    {
        echo "  Tunnel:   ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -N -L 8444:localhost:8443 ${REMOTE_USER}@${SERVER_IP_STR}"
        echo "  URL:      https://localhost:8444/ui/project/${LXD_PROJECT}/instances"
        echo ""
    } >> "$ACCESS_FILE"
    
    # Generate and display the trust token for the UI
    echo -e "${BYELLOW}  Generating LXD UI Trust Token...${NC}"
    echo ""
    
    UI_IDENTITY="tls/se-polymerase-ui"
    UI_TOKEN=$(lxc auth identity create "$UI_IDENTITY" --group admins 2>/dev/null | tail -n 1)
    
    if [ -n "$UI_TOKEN" ]; then
