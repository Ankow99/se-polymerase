# If Nested, use the repro name as VM_NAME
if [ "$NESTED" = true ]; then
    VM_NAME=$REPRO_NAME
fi

if [ -n "$VM_IMAGE" ]; then
    IMAGE="$VM_IMAGE"
fi

# 1. Launch VM
echo ""
echo -e "${BYELLOW}-> 1. Launching LXD VM '${NC}$VM_NAME${BYELLOW}' (${NC}$IMAGE${BYELLOW}) with CPU: ${NC}$CPU_LIMIT cores${BYELLOW} ; RAM: ${NC}${RAM_LIMIT/GiB/ GiB}${BYELLOW} ; DISK: ${NC}${DISK_LIMIT/GiB/ GiB}"
echo ""

if ! lxc init "$IMAGE" "$VM_NAME" --vm --project "$LXD_PROJECT" \
  -p default \
  -c limits.cpu="$CPU_LIMIT" \
  -c limits.memory="$RAM_LIMIT" \
