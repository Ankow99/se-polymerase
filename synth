get_next_synth_id() {
    local used_ids
    used_ids=$(lxc project list --format json 2>/dev/null | jq -r '.[] | select(.config["user.synth.managed"]=="true") | .config["user.synth.id"] // empty' | sort -n)
    local candidate=1
    while echo "$used_ids" | grep -qx "$candidate"; do
        candidate=$((candidate + 1))
    done
    echo "$candidate"
}

save_lab_metadata() {
    local created_br_csv
    created_br_csv=$(IFS=,; echo "${CREATED_BRIDGES[*]}")
    
    lxc project set "$LXD_PROJECT" user.synth.managed="true"
    lxc project set "$LXD_PROJECT" user.synth.id="$SYNTH_ID"
    lxc project set "$LXD_PROJECT" user.synth.deploy_id="$DEPLOY_ID"
    lxc project set "$LXD_PROJECT" user.synth.repro="$REPRO_NAME"
    lxc project set "$LXD_PROJECT" user.synth.status="deploying"
    lxc project set "$LXD_PROJECT" user.synth.primary_vm="$VM_NAME"
    lxc project set "$LXD_PROJECT" user.synth.sys_user="${SYS_USER:-ubuntu}"
    lxc project set "$LXD_PROJECT" user.synth.ssh_key="${SSH_ID:-}"
    lxc project set "$LXD_PROJECT" user.synth.nested="$NESTED"
    lxc project set "$LXD_PROJECT" user.synth.lxd_pool="$LXD_POOL"
    lxc project set "$LXD_PROJECT" user.synth.shared_images="$SHARED_IMAGES"
    lxc project set "$LXD_PROJECT" user.synth.primary_bridge="${PRIMARY_BRIDGE:-}"
    lxc project set "$LXD_PROJECT" user.synth.primary_bridge_created="$PRIMARY_BRIDGE_CREATED"
    lxc project set "$LXD_PROJECT" user.synth.primary_static_ip="${PRIMARY_STATIC_IP:-}"
    lxc project set "$LXD_PROJECT" user.synth.created_bridges="$created_br_csv"
    lxc project set "$LXD_PROJECT" user.synth.volatile_cert="${VOLATILE_CERT:-}"
    lxc project set "$LXD_PROJECT" user.synth.project_dir="$PROJECT_DIR"
    lxc project set "$LXD_PROJECT" user.synth.access_file="$ACCESS_FILE"
    lxc project set "$LXD_PROJECT" user.synth.log_file="$LOG_FILE"
    lxc project set "$LXD_PROJECT" user.synth.config_file="$CONFIG_FILE"
}

split_short_flags() {
    PARSED_ARGS=()
    for arg in "$@"; do
        if [[ "$arg" =~ ^-[a-zA-Z]{2,}$ ]]; then
            for (( i=1; i<${#arg}; i++ )); do
                PARSED_ARGS+=("-${arg:$i:1}")
            done
        else
            PARSED_ARGS+=("$arg")
        fi
    done
}

resolve_lab() {
    local target="$1"
    if [ -z "$target" ]; then
        echo -e "${BRED}Error: You must specify a lab ID, deploy ID, or project name.${NC}" >&2
        echo "Run '$CMD_NAME list' to see active environments." >&2
        return 1
    fi
    
    local target_lower
    target_lower=$(echo "$target" | tr '[:upper:]' '[:lower:]')
    
    local matched_project
    matched_project=$(lxc project list --format json 2>/dev/null | jq -r --arg t "$target" --arg tl "$target_lower" '
        [ .[] | select(.config["user.synth.managed"]=="true") |
          select(
            (.config["user.synth.id"] == $t) or
            ((.config["user.synth.deploy_id"] // "" | ascii_downcase) == $tl) or
            ((.name | ascii_downcase) == $tl)
          )
        ][0].name // empty
    ')
    
    if [ -z "$matched_project" ]; then
        echo -e "${BRED}Error: No managed lab found matching '${NC}${target}${BRED}'.${NC}" >&2
        echo "Run '$CMD_NAME list' to see active environments." >&2
        return 1
    fi
    
    echo "$matched_project"
    return 0
}

get_vm_ipv4() {
    local proj="$1"
    local vm="$2"
    lxc list "$vm" --project "$proj" --format=json 2>/dev/null | jq -r '
        .[0].state.network // {} | to_entries |
        (
            [ .[] | select(.key=="eth0" or .key=="enp5s0") | .value.addresses[]? | select(.family=="inet" and .scope=="global") | .address ] +
            [ .[] | select(.key!="lo") | .value.addresses[]? | select(.family=="inet" and .scope=="global") | .address ]
        ) | .[0] // empty
    ' 2>/dev/null | head -n 1
}

get_status_color() {
    case "$1" in
        deployed)  echo -n "$BGREEN" ;;
        deploying) echo -n "$BYELLOW" ;;
        failed)    echo -n "$BRED" ;;
        *)         echo -n "$NC" ;;
    esac
}

