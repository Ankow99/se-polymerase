case "${1:-}" in
    list|ls)
        shift 1
        cmd_list "$@"
        ;;
    monitor|logs|log)
        shift 1
        cmd_monitor "$@"
        ;;
    shell|connect|ssh)
        shift 1
        cmd_shell "$@"
        ;;
    info)
        shift 1
        cmd_info "$@"
        ;;
    destroy|rm|delete)
        shift 1
        cmd_destroy "$@"
        ;;
    completion)
        shift 1
        cmd_completion "$@"
        ;;
esac

# ==========================================
# DEPLOYMENT HELPER FUNCTIONS
# ==========================================

emergency_rollback() {
    # If the script dies before lab metadata handover completes, clean up the host
    if [ "$CLEANUP_HANDOVER" = false ]; then
        
        # Kill the UI tailer if it's running
        [ -n "$TAIL_PID" ] && kill "$TAIL_PID" 2>/dev/null
        exec 1>&3 2>&4 # Restore terminal output
        
        local rollback_needed=false
        
        # Fast checks for actionable resources
        if [ ${#CREATED_BRIDGES[@]} -gt 0 ] || { [ -n "$VOLATILE_CERT" ] && [ -f "${VOLATILE_CERT}.crt" ]; }; then
            rollback_needed=true
        elif [ "$PROJECT_CREATED" = true ]; then
            rollback_needed=true
        elif [ -n "$LOG_FILE" ] && [ -f "$LOG_FILE" ]; then
            rollback_needed=true
        elif [ -n "$ACCESS_FILE" ] && [ -f "$ACCESS_FILE" ]; then
            rollback_needed=true
        elif [ -n "$CONFIG_FILE_TMP" ] && [ -f "$CONFIG_FILE_TMP" ]; then
            rollback_needed=true
        elif [ -n "$CONFIG_FILE" ] && [ -f "$CONFIG_FILE" ] && [ "$CONFIG_FILE" != "$INPUT_CONFIG_FILE" ]; then
            rollback_needed=true
        fi
        
        # Only sleep and print if there is actual work to do
        if [ "$rollback_needed" = true ]; then
            echo ""
            echo -e "${BRED}Script interrupted! Performing emergency rollback of orphaned resources...${NC}"
            sleep 3
            
            # ONLY delete the project if this specific execution created it
            if [ "$PROJECT_CREATED" = true ]; then
                echo "-> Deleting orphaned LXD project: $LXD_PROJECT"
                for inst in $(lxc list --project "$LXD_PROJECT" --format json | jq -r '.[].name'); do
                    lxc stop -f --project "$LXD_PROJECT" "$inst" 2>/dev/null || true
                    lxc delete -f --project "$LXD_PROJECT" "$inst"
                done
                
                LXD_POOL="${LXD_POOL:-default}"
                
                for vol in $(lxc storage volume list "$LXD_POOL" --project "$LXD_PROJECT" --format json | jq -r '.[] | select(.type=="custom") | .name'); do
                    lxc storage volume delete "$LXD_POOL" "$vol" --project "$LXD_PROJECT"
                done
                
                # Only delete images if the project was created with isolated images
                if [ "$SHARED_IMAGES" = false ]; then
                    for img in $(lxc image list --project "$LXD_PROJECT" --format json | jq -r '.[].fingerprint'); do
                        lxc image delete --project "$LXD_PROJECT" "$img"
                    done
                fi
                
                lxc project switch default 2>/dev/null
                lxc project delete "$LXD_PROJECT"
            fi
            
            # Clean up injected DNS record only if the primary bridge is a shared host network
            if [ "$PRIMARY_BRIDGE_CREATED" = false ] && [ -n "$PRIMARY_BRIDGE" ] && [ -n "$VM_NAME" ] && [ -n "$PRIMARY_STATIC_IP" ]; then
                TARGET_RECORD="host-record=${VM_NAME}.lxd,${PRIMARY_STATIC_IP}"
                CURRENT_DNSMASQ=$(lxc network get "$PRIMARY_BRIDGE" raw.dnsmasq 2>/dev/null || true)
                
                if echo "$CURRENT_DNSMASQ" | grep -qF "$TARGET_RECORD"; then
                    echo "-> Cleaning up specific DNS record on shared Primary Bridge: $PRIMARY_BRIDGE"
                    NEW_DNSMASQ=$(echo "$CURRENT_DNSMASQ" | grep -vF "$TARGET_RECORD")
                    
                    if [ -z "$NEW_DNSMASQ" ]; then
                        lxc network unset "$PRIMARY_BRIDGE" raw.dnsmasq 2>/dev/null || true
                    else
                        lxc network set "$PRIMARY_BRIDGE" raw.dnsmasq="$NEW_DNSMASQ" 2>/dev/null || true
                    fi
                fi
            fi
            
            if [ ${#CREATED_BRIDGES[@]} -gt 0 ]; then
                for br in "${CREATED_BRIDGES[@]}"; do
                    echo "-> Deleting orphaned dynamic bridge: $br"
                    lxc network delete "$br"
                done
            fi
            
            if [ -n "$VOLATILE_CERT" ] && [ -f "${VOLATILE_CERT}.crt" ]; then
                echo "-> Cleaning up orphaned certificates..."
                CERT_NAME="$(basename "$VOLATILE_CERT")"
                FINGERPRINT=$(lxc config trust list --format json | jq -r ".[] | select(.name==\"${CERT_NAME}\") | .fingerprint")
                if [ -n "$FINGERPRINT" ] && [ "$FINGERPRINT" != "null" ]; then
                    lxc config trust remove "$FINGERPRINT"
                fi
                rm -f "${VOLATILE_CERT}.crt" "${VOLATILE_CERT}.key"
            fi
            
            # Clean up generated files on rollback
            for r_file in "$LOG_FILE" "$ACCESS_FILE" "$CONFIG_FILE_TMP" "$TERM_SIZE_FILE"; do
                if [ -n "$r_file" ] && [ -f "$r_file" ]; then
                    echo "-> Cleaning up orphaned $(basename "$r_file")..."
                    rm -f "$r_file" 2>/dev/null || true
                fi
            done
            
            # Ask to keep the generated config file if it wasn't a pre-existing input config file
            if [ -n "$CONFIG_FILE" ] && [ -f "$CONFIG_FILE" ] && [ "$CONFIG_FILE" != "$INPUT_CONFIG_FILE" ]; then
                echo ""
                echo -ne "${BYELLOW}-> Keep generated config file '$(basename "$CONFIG_FILE")' for your next run? [y/N]: ${NC}"
                
                # Catch the input directly from the terminal (tty) only if a TTY exists
                if [ -t 0 ] || [ -c /dev/tty ]; then
                    read -r keep_conf </dev/tty || keep_conf="n"
                else
                    keep_conf="n"
                fi
                
                if [[ "$keep_conf" =~ ^[Yy]$ ]]; then
                    echo -e "-> Kept configuration file at: ${CONFIG_FILE}"
                    echo -e "   (Load it next time by passing: ${BYELLOW}-c $CONFIG_FILE${NC})"
                else
                    echo "-> Cleaning up generated $(basename "$CONFIG_FILE")..."
                    rm -f "$CONFIG_FILE" 2>/dev/null || true
                fi
            fi
            
            # Safely remove project directory if it's completely empty
            if [ -n "$PROJECT_DIR" ] && [ -d "$PROJECT_DIR" ]; then
                rmdir "$PROJECT_DIR" 2>/dev/null || true
            fi
        fi
        
        # Prevent double-execution if multiple exit signals are caught
        CLEANUP_HANDOVER=true 
    fi
}

get_default() {
    grep -E "^\s*\{\%\s*set\s+custom_$1\s*=" "$CLOUD_INIT" | sed -E 's/.*=[[:space:]]*//; s/[[:space:]]*%\}.*//; s/^"//; s/"$//'
}

extract_num() {
    local val
    val=$(echo "$1" | sed -E 's/[^0-9]//g')
    echo "${val:-0}" # Safely fallback to 0 if empty
}

pause_to_continue() {
    local prompt_msg="$1"
    
    # Auto-continue if -y flag was passed
    if [ "$ACCEPT_DEFAULTS" = true ]; then
        return 0
    fi
    
    echo -ne "${prompt_msg} "
    read -r </dev/tty || true
}

confirm_or_abort() {
    local prompt_msg="$1"

    # Auto-confirm if -y flag was passed
    if [ "$ACCEPT_DEFAULTS" = true ]; then
        return 0
    fi

    echo -ne "${prompt_msg} [y/N]: "
    read -r confirm_input </dev/tty
    if [[ ! "$confirm_input" =~ ^[Yy]$ ]]; then
        echo ""
        echo -e "${BRED}Action aborted by user. Exiting.${NC}"
        exit 1
    fi
}

stop_poller_and_clean() {
    if [ -n "$POLLER_PID" ]; then
        kill "$POLLER_PID" 2>/dev/null || true
        for _ in 1 2 3 4 5; do
            kill -0 "$POLLER_PID" 2>/dev/null || break
            sleep 0.1
        done
        kill -9 "$POLLER_PID" 2>/dev/null || true
    fi
    rm -f "$TERM_SIZE_FILE" 2>/dev/null || true
}

print_cluster_inventory() {
    local target="${1:-all}"     # "primary", "nodes", or "all"
    local quiet_mode="$2"        # "quiet" or empty
    local inventory_table=""
    local primary_vm_table=""
    
    # Grabs the top 3 header lines, then searches for the Primary VM name, captures all its lines (even multi-IP), and stops after its closing border
    if [ "$target" = "primary" ] || [ "$target" = "all" ]; then
        primary_vm_table=$(lxc list --project "$LXD_PROJECT" -c ns4 | awk -F'|' -v vm="$VM_NAME" '
        NR<=3 { print $0; next }
        {
            n=$2; gsub(/^[ \t]+|[ \t]+$/, "", n)
            if (n == vm) { capture=1; print $0; next }
            if (capture) {
                print $0
                if ($0 ~ /^\+---/) capture=0
                next
            }
        }')
    fi
    
    # Fetch the rest of the data only once
    if [ "$target" = "nodes" ] || [ "$target" = "all" ]; then
        local used_maas=false
        
        # Only query MAAS if this payload defines the maast helper
        if grep -q "/usr/local/bin/maast" "$CLOUD_INIT" 2>/dev/null; then
            local local_maas_user="${MAAS_USER:-$(get_default maas_user)}"
            local_maas_user="${local_maas_user:-admin}"
            local maas_out=""
            
            if maas_out=$(lxc exec "$VM_NAME" --project "$LXD_PROJECT" -- bash -c "command -v maast >/dev/null 2>&1 && maast '$local_maas_user' machines read" 2>/dev/null); then
                # Verify maast returned actual table rows (not "[ No records found. ]" or an empty header)
                if echo "$maas_out" | grep -E '\|' | grep -vE '\|[[:space:]]*(NAME|HOSTNAME)[[:space:]]*\|' >/dev/null 2>&1; then
                    inventory_table="$maas_out"
                    used_maas=true
                fi
            fi
        fi
        
        # Fallback to LXD if maast isn't in the payload, MAAS failed, or no nodes are enlisted yet
        if [ "$used_maas" = false ]; then
            # Smart AWK filter: Skips the VM row AND its trailing separator, handling multi-line IP rows correctly
            inventory_table=$(lxc list --project "$LXD_PROJECT" -c ns4 | awk -F'|' -v vm="$VM_NAME" '{ n=$2; gsub(/^[ \t]+|[ \t]+$/, "", n); if (n == vm) { skip=1; next } if (skip) { if ($0 ~ /^\+---/) skip=0; next } print $0 }')
            inventory_table=$'\n'"$inventory_table"
        fi
    fi
    
    generate_output() {
        local part="$1"
        if [ "$part" = "primary" ] || [ "$part" = "all" ]; then
            echo "[ SSH Access - Primary VM ]"
            echo "  ssh ${SSH_OPTS[*]} ${SYS_USER}@${IP}"
            echo ""
            echo "$primary_vm_table"
            echo ""
        fi
        if [ "$part" = "nodes" ] || [ "$part" = "all" ]; then
            if echo "$inventory_table" | grep -E '\|' | grep -vE '\|[[:space:]]*(NAME|HOSTNAME)[[:space:]]*\|' >/dev/null 2>&1; then
                echo "[ SSH Access - Cluster Nodes ]"
                echo "  ssh ${SSH_OPTS[*]} ubuntu@<NODE_IP>"
                echo "$inventory_table"
                echo ""
            fi
        fi
    }
    
    if [ -n "$ACCESS_FILE" ]; then        
        # Primary section
        if [ "$target" = "primary" ] || [ "$target" = "all" ]; then
            if ! grep -q "\[ SSH Access - Primary VM \]" "$ACCESS_FILE" 2>/dev/null; then
                generate_output "primary" >> "$ACCESS_FILE"
            fi
        fi
        
        # Nodes section
        if [ "$target" = "nodes" ] || [ "$target" = "all" ]; then
            if ! grep -q "\[ SSH Access - Cluster Nodes \]" "$ACCESS_FILE" 2>/dev/null; then
                generate_output "nodes" >> "$ACCESS_FILE"
            fi
        fi
    fi
    
    # Print Colored Version to Standard Output (Unless 'quiet' is requested)
    if [ "$quiet_mode" != "quiet" ]; then
        generate_output "$target"
    fi
}

# Prompt Helper Function - ask_var "Prompt Text" "jinja_var_name"
ask_var() {
    local prompt_text="$1"
    local config_key="$2"
    local default_val=""
    local user_input=""
    local bash_var_name=""
    local provided_key_var=""
    
    # Extract default value from Jinja cloud-init template
    if [ -n "$config_key" ] && [ -f "$CLOUD_INIT" ]; then
        default_val=$(get_default "$config_key")
    fi
    
    # Check if value was provided in config file
    provided_key_var="CONFIG_PROVIDED_${config_key}"
    
    if [ -v "${provided_key_var}" ]; then
        user_input="${!provided_key_var}"
        echo -e "  ${BYELLOW}${prompt_text} [${NC}from config${BYELLOW}]: ${NC}${user_input}"
    elif [ "$ACCEPT_DEFAULTS" = true ]; then
        user_input="$default_val"
        echo -e "  ${BYELLOW}${prompt_text} [${NC}auto-accepted${BYELLOW}]: ${NC}${user_input}"
    else
        echo -ne "  ${BYELLOW}${prompt_text} [${NC}${default_val}${BYELLOW}]: ${NC}"
        read -r user_input </dev/tty
        user_input="${user_input:-$default_val}"
    fi
    
    # Smart GiB appending
    if [[ "$default_val" == *"GiB" ]] && [[ "$user_input" =~ ^[0-9]+$ ]]; then
        user_input="${user_input}GiB"
    fi
    
    # Save the selected choice to the output config file temporarily
    if [ -n "$CONFIG_FILE_TMP" ] && [ -n "$config_key" ]; then
        echo "${config_key}: \"${user_input}\"" >> "$CONFIG_FILE_TMP"
        PROCESSED_KEYS+=("$config_key")
    fi
    
    # Export to LXC args if a config key exists and export as uppercase bash variable
    if [ -n "$config_key" ]; then
        LXC_OPTIONAL_ARGS+=("-c" "user.${config_key}=${user_input}")
        
        bash_var_name=$(echo "$config_key" | tr '[:lower:]' '[:upper:]')
        export "$bash_var_name"="$user_input"
    fi
}

# Dynamic 3-Path Bridge Generator - create_dynamic_bridge "Prompt Text" "jinja_bridge_name" "dhcp_on/off" "CIDR"
create_dynamic_bridge() {
    local prompt_text="$1"
    local var_key="$2"
    local dhcp_flag="$3"
    local cidr_var="$4"
    
    # Strip 'os_' prefix if it exists, grab 1st letter
    local clean_name="${var_key#os_}"
    local default_br="${clean_name:0:1}br-${DEPLOY_ID}"
    
    local bridge_name=""
    local bridge_cidr=""
    local auto_ip=""
    local default_cidr=""
    local user_cidr=""
    local current_dhcp=""
    local current_nat=""
    local br_checked=false
    local cidr_checked=false
    
    # Setup our loop control variable
    local valid_bridge=false
    
    # Check config file for provided inputs
    local provided_br=""
    local provided_cidr=""
    local provided_key_var="CONFIG_PROVIDED_${var_key}"
    local provided_cidr_var="CONFIG_PROVIDED_${cidr_var}"
    
    if [ -v "${provided_key_var}" ]; then
        provided_br="${!provided_key_var}"
    fi
    if [ -v "${provided_cidr_var}" ]; then
        provided_cidr="${!provided_cidr_var}"
    fi
    
    # Keep prompting until a valid bridge is selected or created
    while [ "$valid_bridge" = false ]; do
        
        # Prompt for value if accept defaults is false
        if [ -v "${provided_key_var}" ] && [ "$br_checked" = false ]; then
            bridge_name="$provided_br"
            echo -e "  ${BYELLOW}${prompt_text} [${NC}from config${BYELLOW}]: ${NC}${bridge_name:-<empty>}"
            br_checked=true # Mark as checked so it drops to default prompt if validation fails
        elif [ "$ACCEPT_DEFAULTS" = true ]; then
            bridge_name="$default_br"
        else
            echo -ne "  ${BYELLOW}${prompt_text} [${NC}${default_br}${BYELLOW}]: ${NC}"
            read -r user_input </dev/tty
            bridge_name="${user_input:-$default_br}"
        fi
        
        # 3-Path CIDR Logic
        if lxc network show "$bridge_name" >/dev/null 2>&1; then
            
            # Using existing bridge, obtain CIDR
            echo -e "    ${BYELLOW}Bridge '${NC}${bridge_name}${BYELLOW}' already exists. Fetching CIDR and checking configuration...${NC}"
            
            # Check DHCP flag
            current_dhcp=$(lxc network get "$bridge_name" ipv4.dhcp 2>/dev/null)
            current_dhcp="${current_dhcp:-true}" # LXD defaults to true if unset
            
            if [ "$current_dhcp" != "$dhcp_flag" ]; then
                echo ""
                echo -e "${BRED}Error: Existing bridge '${NC}${bridge_name}${BRED}' has 'ipv4.dhcp=${NC}${current_dhcp}${BRED}', but this network requires 'ipv4.dhcp=${NC}${dhcp_flag}${BRED}'!${NC}"
                echo "Please specify a different bridge name or delete the conflicting bridge."
                echo ""
                if [ "$ACCEPT_DEFAULTS" = true ]; then
                    exit 1
                else
                    continue
                fi
            fi
            
            # Check NAT flag
            current_nat=$(lxc network get "$bridge_name" ipv4.nat 2>/dev/null)
            current_nat="${current_nat:-false}" # Assume false if strictly unset
            
            if [ "$current_nat" != "true" ]; then
                echo ""
                echo -e "${BRED}Error: Existing bridge '${NC}${bridge_name}${BRED}' has 'ipv4.nat=${NC}${current_nat}${BRED}', but this network requires 'ipv4.nat=${NC}true${BRED}' for outbound internet!${NC}"
                echo "Please specify a different bridge name or enable NAT on this bridge."
                echo ""
                if [ "$ACCEPT_DEFAULTS" = true ]; then
                    exit 1
                else
                    continue
                fi
            fi
            
            auto_ip=$(lxc network get "$bridge_name" ipv4.address)
            bridge_cidr=$(echo "$auto_ip" | awk -F'[/.]' '{print $1"."$2"."$3".0/"$5}')
            
            if [ "$ACCEPT_DEFAULTS" = false ] && [ -z "$INPUT_CONFIG_FILE" ]; then
                echo -e "  ${BYELLOW}${prompt_text% Name} fetched CIDR: ${NC}${bridge_cidr}"
            fi
            
            valid_bridge=true
            
        elif [ "$bridge_name" = "$default_br" ] && [ -z "$provided_cidr" ]; then
            
            # Using random bridge, create it and obtain CIDR
            echo ""
            if [ -z "$INPUT_CONFIG_FILE" ]; then
                confirm_or_abort "Create new random ${prompt_text% Name} '$bridge_name' to auto-assign CIDR?"
            fi
            
            echo "Creating random managed '$bridge_name' (DHCP=${dhcp_flag})..."
            if ! lxc network create "$bridge_name" \
              ipv4.nat=true \
              ipv4.dhcp="$dhcp_flag" \
              ipv6.address=none; then
                echo ""
                echo -e "${BRED}Error: Failed to create random ${prompt_text% Name} '${NC}$bridge_name${BRED}'. Please try again...${NC}"
                echo ""
                
                lxc network delete "$bridge_name" >/dev/null 2>&1 || true
                
                if [ "$ACCEPT_DEFAULTS" = true ]; then
                    exit 1
                else
                    continue
                fi
            fi
            
            lxc network set "$bridge_name" --property description="${PRETTY_REPRO} ${prompt_text% Name} ($DEPLOY_ID)"
            CREATED_BRIDGES+=("$bridge_name")
            
            auto_ip=$(lxc network get "$bridge_name" ipv4.address)
            bridge_cidr=$(echo "$auto_ip" | awk -F'[/.]' '{print $1"."$2"."$3".0/"$5}')
            echo ""
            if [ "$ACCEPT_DEFAULTS" = false ] && [ -z "$INPUT_CONFIG_FILE" ]; then
                echo -e "  ${BYELLOW}${prompt_text% Name} Auto-Assigned CIDR: ${NC}${bridge_cidr}"
            fi
            
            valid_bridge=true
            
        else
            
            # Creating new bridge, ask for CIDR
            echo -e "    ${BYELLOW}Bridge '${NC}${bridge_name}${BYELLOW}' doesn't exist. Asking for new CIDR...${NC}"
            
            default_cidr=$(get_default "$cidr_var")
            [ -z "$default_cidr" ] && default_cidr="10.0.0.0/22"
            
            if [ -v "${provided_cidr_var}" ] && [ "$cidr_checked" = false ]; then
                bridge_cidr="$provided_cidr"
                echo -e "  ${BYELLOW}${prompt_text% Name} CIDR [${NC}from config${BYELLOW}]: ${NC}${bridge_cidr:-<empty>}"
                cidr_checked=true # Mark as checked so it drops to default prompt if validation fails
            else
                echo -ne "  ${BYELLOW}${prompt_text% Name} CIDR [${NC}${default_cidr}${BYELLOW}]: ${NC}"
                read -r user_cidr </dev/tty
                bridge_cidr="${user_cidr:-$default_cidr}"
            fi
            
            echo ""
            if [ -z "$INPUT_CONFIG_FILE" ]; then
                confirm_or_abort "Create custom managed ${prompt_text% Name} '$bridge_name' ($bridge_cidr)?"
            fi
            
            echo "Creating custom managed '$bridge_name' ($bridge_cidr DHCP=${dhcp_flag})..."
            read -r gw_ip prefix <<< "$(python3 -c "
import ipaddress, sys
try:
    net = ipaddress.IPv4Network('$bridge_cidr', strict=False)
    if net.prefixlen >= 30:
        print('TOO_SMALL')
        sys.exit(0)
    print(f'{list(net.hosts())[0]} {net.prefixlen}')
except Exception:
    print('ERROR')
")"
            if [ "$gw_ip" = "TOO_SMALL" ]; then
                echo ""
                echo -e "${BRED}Error: CIDR '${NC}${bridge_cidr}${BRED}' is too small for a bridge subnet. Must be /29 or larger. Please try again...${NC}"
                echo ""
                if [ "$ACCEPT_DEFAULTS" = true ]; then
                    exit 1
                else
                    continue
                fi
            elif [ "$gw_ip" = "ERROR" ] || [ -z "$gw_ip" ]; then
                echo ""
                echo -e "${BRED}Error: Invalid CIDR format '${NC}${bridge_cidr}${BRED}' provided for bridge '${NC}$bridge_name${BRED}'. Please try again...${NC}"
                echo ""
                if [ "$ACCEPT_DEFAULTS" = true ]; then
                    exit 1
                else
                    continue
                fi
            fi
            
            if ! lxc network create "$bridge_name" \
              ipv4.address="${gw_ip}/${prefix}" \
              ipv4.nat=true \
              ipv4.dhcp="$dhcp_flag" \
              ipv6.address=none; then
                echo ""
                echo -e "${BRED}Error: Failed to create custom ${prompt_text% Name} '${NC}$bridge_name${BRED}'. Please try again...${NC}"
                echo ""
                
                lxc network delete "$bridge_name" >/dev/null 2>&1 || true
                default_br="$bridge_name" # Save custom name for next prompt
                
                if [ "$ACCEPT_DEFAULTS" = true ]; then
                    exit 1
                else
                    continue
                fi
            fi
            lxc network set "$bridge_name" --property description="${PRETTY_REPRO} ${prompt_text% Name} ($DEPLOY_ID)"
            CREATED_BRIDGES+=("$bridge_name")
            echo ""

            valid_bridge=true
        fi
    done
    
    # Save the selected choice to the output config file temporarily
    if [ -n "$CONFIG_FILE_TMP" ]; then
        echo "${var_key}: \"${bridge_name}\"" >> "$CONFIG_FILE_TMP"
        echo "${cidr_var}: \"${bridge_cidr}\"" >> "$CONFIG_FILE_TMP"
        PROCESSED_KEYS+=("$var_key" "$cidr_var")
    fi
    
    # Export Bridge Name into LXC args and bash env
    LXC_OPTIONAL_ARGS+=("-c" "user.${var_key}=${bridge_name}")
    export "$(echo "$var_key" | tr '[:lower:]' '[:upper:]')"="$bridge_name"

    # Export CIDR into LXC args and bash env
    LXC_OPTIONAL_ARGS+=("-c" "user.${cidr_var}=${bridge_cidr}")
    export "$(echo "$cidr_var" | tr '[:lower:]' '[:upper:]')"="$bridge_cidr"
    
    # Track Primary Bridge Gateway for Netplan injection later
    if [ -z "$PRIMARY_BRIDGE" ]; then
        read -r gw mask stat <<< "$(python3 -c "
import ipaddress, sys
try:
    net = ipaddress.IPv4Network('$bridge_cidr', strict=False)
    if net.prefixlen >= 30:
        print('ERROR')
        sys.exit(0)
    hosts = list(net.hosts())
    print(f'{hosts[0]} {net.prefixlen} {hosts[1]}')
except Exception:
    print('ERROR')
")"
        if [ "$gw" = "ERROR" ] || [ -z "$gw" ]; then
            echo ""
            echo -e "${BRED}Error: Could not calculate Primary VM network properties from CIDR '${NC}$bridge_cidr${BRED}'. Exiting.${NC}"
            exit 1
        fi
        
        PRIMARY_BRIDGE="$bridge_name"
        PRIMARY_GW_IP="$gw"
        PRIMARY_MASK="$mask"
        PRIMARY_STATIC_IP="$stat"
        
        # If this bridge was dynamically created, flip the global flag
        if [[ " ${CREATED_BRIDGES[*]} " == *" $bridge_name "* ]]; then
            PRIMARY_BRIDGE_CREATED=true
        fi
    fi
}

# ==========================================
# FUNCTION PARAMETERS
# ==========================================

split_short_flags "$@"
set -- ${PARSED_ARGS[@]+"${PARSED_ARGS[@]}"}

CLI_MAAS_SNAP=""
CLI_NESTED_LXD=""

# --- Argument Parsing ---
echo ""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            ;;
        -y|--yes)
            echo -e "${BYELLOW}-> Accepting all default template values (-y)${NC}"
            echo ""
            ACCEPT_DEFAULTS=true
            shift 1
            ;;
        -n|--nested)
            CLI_NESTED_LXD="true"
            shift 1
            ;;
        -d|--deb)
            CLI_MAAS_SNAP="false"
            shift 1
            ;;
        -i|--id)
            if [[ -n "$2" && "$2" != -* ]]; then
                echo -e "${BYELLOW}-> Importing SSH keys from user ID:${NC} $2"
                echo ""
                LXC_OPTIONAL_ARGS+=("-c" "user.ssh_import_id=$2")
                shift 2
            else
                echo -e "${BRED}Error: $1 requires a user ID argument.${NC}"
                exit 1
            fi
            ;;
        -I|--isolate-images)
            echo -e "${BYELLOW}-> Isolating LXD images per project (-I)${NC}"
            echo ""
            SHARED_IMAGES=false
            shift 1
            ;;
        -c|--config)
            if [[ -n "$2" && "$2" != -* ]]; then
                INPUT_CONFIG_FILE="$2"
                echo -e "${BYELLOW}-> Loading configuration from:${NC} $INPUT_CONFIG_FILE"
                echo ""
                shift 2
            else
                echo -e "${BRED}Error: $1 requires a file path argument.${NC}"
                exit 1
            fi
            ;;
        -m|--manifest)
            if [[ -n "$2" && "$2" != -* ]]; then
                CUSTOM_MANIFEST_FILE="$2"
                echo -e "${BYELLOW}-> Using custom Sunbeam manifest:${NC} $CUSTOM_MANIFEST_FILE"
                echo ""
                shift 2
            else
                echo -e "${BRED}Error: $1 requires a file path argument.${NC}"
                exit 1
            fi
            ;;
        -*)
            echo -e "${BRED}Error: Unknown flag '${NC}${1}${BRED}'${NC}"
            exit 1
            ;;
        *)
            # Catch all non-flag arguments (File path and Deploy ID)
            POSITIONAL_ARGS+=("$1")
            shift 1
            ;;
    esac
done

# ==========================================
# POSITIONAL ARGUMENT RESOLUTION
# ==========================================

# Resolve the Cloud-Init Payload File
if [ ${#POSITIONAL_ARGS[@]} -lt 1 ]; then
    echo -e "${BRED}Error: You must provide the path to a cloud-init template.${NC}"
    echo "Usage: $CMD_NAME [OPTIONS] <CLOUD_INIT_FILE> [DEPLOY_ID]"
    exit 1
fi

CLOUD_INIT_FILE="${POSITIONAL_ARGS[0]}"

if [ ! -f "$CLOUD_INIT_FILE" ]; then
    echo -e "${BRED}Error: Payload file '${NC}${CLOUD_INIT_FILE}${BRED}' not found!${NC}"
    exit 1
fi

if [ -n "$INPUT_CONFIG_FILE" ]; then
    if [ ! -f "$INPUT_CONFIG_FILE" ]; then
        echo -e "${BRED}Error: Configuration file '${NC}${INPUT_CONFIG_FILE}${BRED}' not found!${NC}"
        exit 1
    fi
    # Force absolute path immediately so later comparisons don't fail
    INPUT_CONFIG_FILE="$(realpath "$INPUT_CONFIG_FILE")"
fi

if [ -n "$CUSTOM_MANIFEST_FILE" ]; then
    if [ ! -f "$CUSTOM_MANIFEST_FILE" ]; then
        echo -e "${BRED}Error: Custom manifest file '${NC}${CUSTOM_MANIFEST_FILE}${BRED}' not found!${NC}"
        exit 1
    fi
fi

# Dynamically set directories based on the resolved absolute path of the file
CLOUD_INIT="$(realpath "$CLOUD_INIT_FILE")"
SCRIPT_DIR="$(dirname "$CLOUD_INIT")"

# Pre-Load Config Variables
if [ -n "$INPUT_CONFIG_FILE" ]; then
    while IFS=':' read -r key val; do
        # Skip comments and empty lines
        [[ "$key" =~ ^#.*$ || -z "$key" ]] && continue
        
        # Clean up key and val spaces and quotes
        key=$(echo "$key" | xargs)
        val=$(echo "$val" | sed -E 's/^[[:space:]]*//' | sed 's/^"\(.*\)"$/\1/' | sed "s/^'\(.*\)'$/\1/" | xargs)
        
        export "CONFIG_PROVIDED_${key}=${val}"
    done < "$INPUT_CONFIG_FILE"
fi

# Resolve the Deploy ID Overwrite (If provided)
if [ ${#POSITIONAL_ARGS[@]} -ge 2 ]; then
    # Directly override and lowercase the default Deploy ID
    DEPLOY_ID=$(echo "${POSITIONAL_ARGS[1]}" | tr '[:upper:]' '[:lower:]')
elif [ -n "${CONFIG_PROVIDED_deploy_id}" ]; then
    DEPLOY_ID="${CONFIG_PROVIDED_deploy_id}"
elif [ -n "${CONFIG_PROVIDED_lxd_project}" ] && [[ "${CONFIG_PROVIDED_lxd_project}" == *"-"* ]]; then
    DEPLOY_ID="${CONFIG_PROVIDED_lxd_project##*-}"
fi

# Verify deploy ID
if [[ ! "$DEPLOY_ID" =~ ^[a-z0-9]{1,8}$ ]]; then
    echo -e "${BRED}Error: Invalid Deployment ID '${NC}${DEPLOY_ID}${BRED}'${NC}"
    echo "The Deployment ID must be between 1 and 8 lowercase letters and/or numbers (no dashes)."
    exit 1
fi

# Generate a predictable port offset (0-4999) based on the unique deployment ID
PORT_OFFSET=$(echo -n "$DEPLOY_ID" | cksum | awk '{print $1 % 5000}')

# Allocate VM-specific ports in high, uncommonly used ranges
MAAS_LOCAL_PORT=$(( 50000 + PORT_OFFSET ))
HORIZON_LOCAL_PORT=$(( 55000 + PORT_OFFSET ))

# ==========================================
# INITIAL DEPENDENCY CHECK
# ==========================================

# Determine if sudo is needed
SUDO_CMD=""
[ "$EUID" -ne 0 ] && SUDO_CMD="sudo"

# Pre-evaluate the storage backend, hunt for a completely empty raw disk (no partitions, not mounted)
LXD_STORAGE_DRIVER="$LXD_NON_SPARE_DRIVER"
SPARE_DISK=$(lsblk -ndo NAME,TYPE | awk '$2=="disk"{print $1}' | while read -r dev; do
    # Skip virtual devices like zram, loop, etc
    if [[ "$dev" == zram* ]] || [[ "$dev" == loop* ]] || [[ "$dev" == sr* ]]; then
        continue
    fi
    
    if ! lsblk -n "/dev/$dev" | grep -q "part"; then
        echo "/dev/$dev"
        break
    fi
done)

# Verify it's greater than 500 GiB
if [ -n "$SPARE_DISK" ]; then
    SPARE_SIZE_GIB=$(lsblk -bndo SIZE "$SPARE_DISK" | awk '{printf "%.0f", $1/1073741824}')
    if [ "$SPARE_SIZE_GIB" -ge 500 ]; then
        LXD_STORAGE_DRIVER="$LXD_SPARE_DRIVER"
    else
        SPARE_DISK="" # Too small, reject it
    fi
fi

# Check for missing apt packages
MISSING_APT=()
for cmd in jq openssl python3 ssh base64 awk sed; do
    if ! command -v "$cmd" &> /dev/null; then
        MISSING_APT+=("$cmd")
    fi
done

# Check for the utility of the selected backend
if [ "$LXD_STORAGE_DRIVER" = "lvm" ] && ! command -v lvm &> /dev/null; then
    MISSING_APT+=("lvm2")
elif [ "$LXD_STORAGE_DRIVER" = "zfs" ] && ! command -v zfs &> /dev/null; then
    MISSING_APT+=("zfsutils-linux")
fi

# Check if LXD is missing or uninitialized
NEEDS_LXD_SNAP=false
NEEDS_LXD_INIT=false

if ! snap list lxd &> /dev/null; then
    NEEDS_LXD_SNAP=true
    NEEDS_LXD_INIT=true
elif ! lxc storage list --format json | jq -e 'length > 0' > /dev/null 2>&1; then
    NEEDS_LXD_INIT=true
fi

# If anything is missing or uninitialized, handle it explicitly
if [ ${#MISSING_APT[@]} -gt 0 ] || [ "$NEEDS_LXD_SNAP" = true ] || [ "$NEEDS_LXD_INIT" = true ]; then
    echo -e "${BYELLOW}-> Environment Setup Required${NC}"
    echo ""
    [ ${#MISSING_APT[@]} -gt 0 ] && echo -e "Missing packages: ${BRED}${MISSING_APT[*]}${NC}"
    [ "$NEEDS_LXD_SNAP" = true ] && echo -e "Missing snap: ${BRED}lxd${NC}"
    [ "$NEEDS_LXD_INIT" = true ] && echo -e "Status: ${BYELLOW}LXD requires initialization${NC}"
    echo ""
    
    confirm_or_abort "Would you like to automatically install dependencies and initialize LXD with '${LXD_STORAGE_DRIVER}' backend?"
    echo ""
    
    # 1. Install APT dependencies
    if [ ${#MISSING_APT[@]} -gt 0 ]; then
        echo -e "${BYELLOW}-> Installing missing dependencies...${NC}"
        echo ""
        $SUDO_CMD apt-get update >/dev/null 2>&1
        $SUDO_CMD apt-get install -y "${MISSING_APT[@]}"
        echo ""
    fi
    
    # 2. Install LXD snap if missing
    if [ "$NEEDS_LXD_SNAP" = true ]; then
        echo -e "${BYELLOW}-> Installing LXD snap:${NC} ${HOST_LXD_CHANNEL}"
        echo ""
        $SUDO_CMD snap install lxd --channel="${HOST_LXD_CHANNEL}"
        echo ""
    fi
    
    # 3. Initialize LXD
    if [ "$NEEDS_LXD_INIT" = true ]; then
        echo -e "${BYELLOW}-> Initializing LXD with '${NC}${LXD_STORAGE_DRIVER}${BYELLOW}' storage backend...${NC}"
        echo ""
        
        # Sleep to ensure the snap daemon is fully ready after fresh install
        sleep 3
        
        # Base initialization array
        INIT_CMD=(lxd init --auto --storage-backend="${LXD_STORAGE_DRIVER}")
        
        if [ -n "$SPARE_DISK" ] && [ "$LXD_STORAGE_DRIVER" != "dir" ]; then
            echo -e "Found bare-metal secondary disk '${SPARE_DISK}' (${SPARE_SIZE_GIB} GiB). Feeding it to LXD..."
            INIT_CMD+=("--storage-create-device=${SPARE_DISK}")
        else
            if [ -n "$SPARE_DISK" ] && [ "$LXD_STORAGE_DRIVER" = "dir" ]; then
                echo -e "Directory backend selected; ignoring raw block device '${SPARE_DISK}'..."
            else
                echo -e "No suitable spare disk found. Falling back to '${LXD_STORAGE_DRIVER}'..."
            fi
            
            # Calculate 95% of available disk space on / (in GiB)
            FREE_SPACE_GIB=$(df -BG / | awk 'NR==2 {print $4}' | sed -E 's/[^0-9]//g')
            LOOP_SIZE=$(( FREE_SPACE_GIB * 95 / 100 ))
            
            if [ "$LOOP_SIZE" -lt 10 ]; then
                echo -e "${BRED}Error: Less than '10 GiB' of free space available to allocate to LXD!${NC}"
                exit 1
            fi
            
            if [ "$LXD_STORAGE_DRIVER" != "dir" ]; then
                echo -e "Allocating '${LOOP_SIZE} GiB' sparse loop device for '${LXD_STORAGE_DRIVER}' pool..."
                INIT_CMD+=("--storage-create-loop=${LOOP_SIZE}")
            else
                echo -e "Using directory backend on root filesystem..."
            fi
        fi
        
        # Execute the dynamic initialization command
        if ! $SUDO_CMD "${INIT_CMD[@]}"; then
            echo ""
            echo -e "${BRED}Error: Failed to auto-initialize LXD. Please run '${NC}${INIT_CMD[*]}${BRED}' manually and try again.${NC}"
            exit 1
        fi
        
        # Apply ZFS optimizations if ZFS was selected as either backend
        if [ "$LXD_STORAGE_DRIVER" = "zfs" ]; then
            $SUDO_CMD zpool set autotrim=on default 2>/dev/null || true
            echo 2147483648 | $SUDO_CMD tee /sys/module/zfs/parameters/zfs_arc_max >/dev/null
            echo "options zfs zfs_arc_max=2147483648" | $SUDO_CMD tee /etc/modprobe.d/zfs.conf >/dev/null
        fi
        
        echo -e "LXD initialized successfully."
        echo ""
    fi
fi

