#!/bin/bash

# ---
# se-polymerase (synth)
# Acts as the polymerase to synthesize an isolated, terraform-free LXD 
# reproducer environment using the host's LXD for MAAS + Juju deployments.
# version: 12.0.0
#
# Synthesized by: Pablo Gonzalez De Greiff @ Canonical
# ---

set +e

# Save original stdout/stderr for later restoration (needed for final interactive ssh and UI separation)
exec 3>&1 4>&2

# Unified unique deployment ID (Can be changed to case number - 8 numbers) (Inherit from parent if forked)
DEPLOY_ID="${DEPLOY_ID:-$(openssl rand -hex 4)}"

# Host system LXD snap track (independent from payload configs)
HOST_LXD_CHANNEL="5.21/stable"

# Define preferred storage backend for bare-metal disks ("zfs", "lvm", or "dir")
LXD_SPARE_DRIVER="dir"

# Define fallback storage backend for loop files ("zfs" or "dir")
LXD_NON_SPARE_DRIVER="dir"

# Arrays to hold dynamic configuration
LXC_OPTIONAL_ARGS=()
DEFERRED_CONFIG=()

# Prevent specific dynamic/internal variables from being hardcoded into the config file
PROCESSED_KEYS=("ssh_key" "ssh_import_id" "nested_lxd" "maas_snap" "deploy_id" "lxd_project")

# Deployment variables
NESTED=false # Use nested LXD instead of host's LXD (performance degradation)
ACCEPT_DEFAULTS=false # Auto accept all defaults flag
SHARED_IMAGES=true # Share host LXD images by default (false = isolated images per project)
CLEANUP_HANDOVER=false # Emergency rollback cleanup handover flag
PROJECT_CREATED=false # Tracks if it created the LXD project to prevent wiping existing ones
CLOUD_INIT_LOG_LINES=9 # Lines to show while Juju status watch
MAX_WAIT=300 # Maximum wait time in seconds for loops

INPUT_CONFIG_FILE=""

# --- Colors ---
# Check if stderr is a TTY
if [ -t 2 ]; then
    BRED='\033[1;31m'
    BGREEN='\033[1;32m'
    BYELLOW='\033[1;33m'
    NC='\033[0m'
else
    BRED=''
    BGREEN=''
    BYELLOW=''
    NC=''
fi

if command -v "$(basename "$0")" >/dev/null 2>&1; then
    CMD_NAME="$(basename "$0")"
else
    CMD_NAME="$0"
fi

