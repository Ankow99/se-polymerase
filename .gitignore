# Ignore generated se-polymerase deployment directories
*/*/
# Exception for templates folder and its contents
!*/templates/
!*/templates/**

# Fallback explicit ignore for generated artifacts if they leak out of a folder
destroy-*.sh
config-*.yaml
config-*.yaml.tmp
access-*.txt
log-*.log
.cert-*
.worker-*.pid

# Ignore custom folders and files
credentials
